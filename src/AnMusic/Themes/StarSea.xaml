<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 星海蓝（深色，默认皮肤）：取自应用图标 AnMusic.png ——
         深靛蓝底（#0B1A65 系列）+ 品牌蓝强调（音符上的蓝青渐变中段）。
         底色比图标本身压暗一档，长时间看不刺眼；强调色保持图标那种"亮蓝"以在深底上跳出来。 -->

    <SolidColorBrush x:Key="BgMain" Color="#0A0F42"/>
    <SolidColorBrush x:Key="BgMainAlpha" Color="#EA0A0F42"/>
    <SolidColorBrush x:Key="BgContentAlpha" Color="#EA0A0F42"/>
    <SolidColorBrush x:Key="BgPanel" Color="#131A5C"/>
    <SolidColorBrush x:Key="BgDeeper" Color="#070A2E"/>
    <SolidColorBrush x:Key="BgControl" Color="#1B2470"/>
    <SolidColorBrush x:Key="BgControlHover" Color="#28339A"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#232C7A"/>
    <SolidColorBrush x:Key="BgPlaybar" Color="#0E144F"/>

    <SolidColorBrush x:Key="FgPrimary" Color="#EDEFFB"/>
    <SolidColorBrush x:Key="FgNormal" Color="#D3D9F2"/>
    <SolidColorBrush x:Key="FgSecondary" Color="#98A2D2"/>
    <SolidColorBrush x:Key="FgMuted" Color="#6C76A8"/>
    <SolidColorBrush x:Key="FgSidebar" Color="#BFC7E8"/>

    <SolidColorBrush x:Key="Accent" Color="#4C8DFF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#6EA5FF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#17246B"/>
    <SolidColorBrush x:Key="BtnPrimaryFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentWarm" Color="#F59E0B"/>
</ResourceDictionary>
