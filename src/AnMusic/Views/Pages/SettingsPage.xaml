<UserControl x:Class="AnMusic.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:AnMusic.Converters"
             mc:Ignorable="d"
             Background="{DynamicResource BgContentAlpha}"
             Focusable="True"
             PreviewKeyDown="SettingsPage_PreviewKeyDown"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <converters:PathToImageConverter x:Key="PathToImageConv"/>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyToVis"/>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgNormal}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="PageButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgControl}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}"/>
        </Style>
        <Style x:Key="PageCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="MaxDropDownHeight" Value="200"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- 主框：主题色底，圆角 -->
                            <Border x:Name="Bd" Background="{DynamicResource BgControl}"
                                    CornerRadius="6" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"/>
                            <!-- 选中项文字 -->
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              IsHitTestVisible="False"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              TextBlock.Foreground="{DynamicResource FgPrimary}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"/>
                            <!-- 下拉箭头 -->
                            <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource FgSecondary}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                  IsHitTestVisible="False"/>
                            <!-- 命中区：整框点击展开 -->
                            <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- 下拉弹层 -->
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource BgPanel}" CornerRadius="6"
                                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                        Margin="0,2,0,8" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter Margin="2"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource FgNormal}"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="146"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：设置分类（点击切换右侧只显示该分类的分区） -->
        <StackPanel Grid.Column="0" Margin="24,24,8,24">
            <TextBlock Text="设置" Foreground="{DynamicResource FgPrimary}"
                       FontSize="20" FontWeight="Bold" Margin="6,0,0,10"/>
            <ItemsControl ItemsSource="{Binding SettingsCategories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Name}" Tag="{Binding Name}" Click="SettingsCategory_Click"
                                HorizontalContentAlignment="Left" Padding="10,7" Margin="0,2"
                                FontSize="12.5" Cursor="Hand" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
                                    <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BgControl}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- 右：搜索框（固定）+ 当前分类的设置分区（滚动） -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 设置搜索：输入关键词跨分类过滤设置项 -->
            <Border Grid.Row="0" Background="{DynamicResource BgControl}" CornerRadius="10" Padding="6,0"
                    Margin="0,24,24,0" MaxWidth="320" HorizontalAlignment="Left">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="🔍" Foreground="{DynamicResource FgMuted}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="搜索设置项（如 音量/皮肤/缓存/歌词…）" Foreground="{DynamicResource FgMuted}"
                               FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SettingsFilter}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="SettingsSearchBox"
                             Text="{Binding SettingsFilter, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource FgPrimary}" FontSize="11"
                             VerticalContentAlignment="Center"
                             TextChanged="SettingsSearch_TextChanged"
                             KeyDown="SettingsSearch_KeyDown"/>
                </DockPanel>
            </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="RootPanel" Margin="0,4,24,32" MaxWidth="560" HorizontalAlignment="Left">

            <!-- 外观 -->
            <!-- ===== 分区：Appearance ===== -->
            <StackPanel Tag="sec:外观" x:Name="Section_Appearance">
            <TextBlock Text="外观" Style="{StaticResource SectionTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="皮肤" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="整体配色方案（底色 + 配套强调色）" Style="{StaticResource SettingDesc}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="132" Style="{StaticResource PageCombo}"
                          ItemsSource="{Binding SkinNames}"
                          SelectedIndex="{Binding SkinIndex}"/>
            </Grid>

            <!-- 强调色 -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="强调色" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="在皮肤基础上单独调整主色（标题栏 🎨 可预览切换）" Style="{StaticResource SettingDesc}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="132" Style="{StaticResource PageCombo}"
                          ItemsSource="{Binding AccentNames}"
                          SelectedIndex="{Binding AccentColorIndex}"/>
            </Grid>

            <!-- 音乐库 -->
            <!-- ===== 分区：LibraryDir ===== -->
            </StackPanel>
            <StackPanel Tag="sec:通用" x:Name="Section_LibraryDir">
            <TextBlock Text="音乐库" Style="{StaticResource SectionTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource SettingLabel}"
                               TextTrimming="CharacterEllipsis" Text="{Binding MusicDirectory, FallbackValue=音乐文件夹}"/>
                    <TextBlock Text="启动时自动扫描该目录" Style="{StaticResource SettingDesc}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="浏览..." Style="{StaticResource PageButton}"
                        Command="{Binding BrowseMusicDirectoryCommand}"/>
            </Grid>

            <!-- 网络代理 -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="网络代理" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="留空 = 跟随系统；如 http://127.0.0.1:7890（改完立即生效）"
                               Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBox Grid.Column="1" Width="200" Padding="8,5" FontSize="12"
                         Background="{DynamicResource BgControl}" BorderThickness="0"
                         Foreground="{DynamicResource FgPrimary}"
                         Text="{Binding ProxyUrl, UpdateSourceTrigger=LostFocus}"
                         ToolTip="支持 http:// 与 socks5:// 形式的代理地址"/>
            </Grid>

            <!-- 下载 -->
            <!-- ===== 分区：Download ===== -->
            </StackPanel>
            <StackPanel Tag="sec:通用" x:Name="Section_Download">
            <TextBlock Text="下载" Style="{StaticResource SectionTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource SettingLabel}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding DownloadDirectoryLabel}"/>
                    <TextBlock Text="在线歌曲下载保存位置；未设置时保存到音乐库目录（默认 我的音乐\AnMusic）"
                               Style="{StaticResource SettingDesc}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="浏览..." Style="{StaticResource PageButton}" Margin="0,0,6,0"
                            Command="{Binding BrowseDownloadDirectoryCommand}"/>
                    <Button Content="默认" Style="{StaticResource PageButton}" ToolTip="恢复默认（跟随音乐库目录）"
                            Command="{Binding ClearDownloadDirectoryCommand}"/>
                </StackPanel>
            </Grid>

            <!-- 播放 -->
            <!-- ===== 分区：Play ===== -->
            </StackPanel>
            <StackPanel Tag="sec:播放" x:Name="Section_Play">
            <TextBlock Text="播放" Style="{StaticResource SectionTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="默认音量" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="启动时使用的音量" Style="{StaticResource SettingDesc}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DefaultVolume, StringFormat={}{0:P0}}"
                               Foreground="{DynamicResource FgSecondary}" FontSize="11"
                               HorizontalAlignment="Right"/>
                    <Slider Minimum="0" Maximum="1" Value="{Binding DefaultVolume}" IsMoveToPointEnabled="True"/>
                </StackPanel>
            </Grid>

            <!-- 快捷键 -->
            <!-- ===== 分区：Shortcuts ===== -->
            </StackPanel>
            <StackPanel Tag="sec:播放" x:Name="Section_Shortcuts">
            <TextBlock Text="快捷键" Style="{StaticResource SectionTitle}"/>
            <CheckBox IsChecked="{Binding ShortcutsEnabled}" Content="启用键盘快捷键"
                      Foreground="{DynamicResource FgNormal}" FontSize="12.5" Cursor="Hand"/>
            <TextBlock Style="{StaticResource SettingDesc}" TextWrapping="Wrap" Margin="0,5,0,8"
                       Text="点「修改」后按下新的按键组合即可改键；Esc 取消，Delete 清除该项。勾选「全局」后在其他程序窗口中也生效（全局热键必须包含 Ctrl / Alt / Shift）。"/>
            <ItemsControl ItemsSource="{Binding ShortcutItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource FgNormal}"
                                           FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Tip}" Foreground="{DynamicResource FgMuted}"
                                           FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <!-- 当前按键（捕获中 / 未设置 / 冲突 三种状态变色） -->
                            <Border Grid.Column="1" MinWidth="104" Padding="8,4" CornerRadius="6"
                                    Background="{DynamicResource BgControl}" ToolTip="{Binding Warning}">
                                <TextBlock Text="{Binding GestureText}" FontSize="11.5" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUnset}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                    <Setter Property="Foreground" Value="#E5484D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <CheckBox Grid.Column="2" Content="全局" IsChecked="{Binding IsGlobal}"
                                      Foreground="{DynamicResource FgSecondary}" FontSize="11"
                                      VerticalAlignment="Center" Margin="8,0,0,0"
                                      ToolTip="在其他程序窗口中也生效（需含修饰键）"/>
                            <Button Grid.Column="3" Content="修改" Click="ShortcutEdit_Click"
                                    Style="{StaticResource PageButton}" Padding="10,4" FontSize="11.5"
                                    Margin="8,0,0,0" ToolTip="点击后按下新的按键组合"/>
                            <Button Grid.Column="4" Content="重置" Click="ShortcutReset_Click"
                                    Style="{StaticResource PageButton}" Padding="10,4" FontSize="11.5"
                                    Margin="6,0,0,0" ToolTip="恢复该项默认按键"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="全部恢复默认" Command="{Binding ResetAllShortcutsCommand}"
                    Style="{StaticResource PageButton}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Tag="sec:外观" x:Name="Section_Wallpaper">
            <TextBlock Text="背景图片" Style="{StaticResource SectionTitle}"/>
            <!-- 预览缩略图：即时查看设置效果 -->
            <Border CornerRadius="6" Margin="0,0,0,8" MaxWidth="220" HorizontalAlignment="Left"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                    Visibility="{Binding BackgroundImagePath, Converter={StaticResource StrNotEmptyToVis}}">
                <Image Source="{Binding BackgroundImagePath, Converter={StaticResource PathToImageConv}}"
                       MaxHeight="120" Stretch="Uniform"/>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource SettingLabel}"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding BackgroundImagePath, FallbackValue=（未设置，使用默认背景）}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="不透明度" Foreground="{DynamicResource FgSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider Minimum="0" Maximum="1" Value="{Binding BackgroundOpacity}"
                                Width="120" VerticalAlignment="Center" IsMoveToPointEnabled="True"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="选择图片..." Style="{StaticResource PageButton}"
                            Command="{Binding BrowseBackgroundCommand}" Margin="0,0,6,0"/>
                    <Button Content="清除" Style="{StaticResource PageButton}"
                            Command="{Binding ClearBackgroundCommand}"/>
                </StackPanel>
            </Grid>

            <!-- 动态壁纸 -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="动态壁纸" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="在背景层渲染粒子动画（鼠标跟随/星河），颜色跟随主题强调色" Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="140" Style="{StaticResource PageCombo}"
                          SelectedIndex="{Binding WallpaperIndex}">
                    <ComboBoxItem Content="关闭"/>
                    <ComboBoxItem Content="鼠标跟随"/>
                    <ComboBoxItem Content="星河"/>
                </ComboBox>
            </Grid>

            <!-- 音乐源 -->
            <!-- ===== 分区：Sources ===== -->
            </StackPanel>
            <StackPanel Tag="sec:音源" x:Name="Section_Sources">
            <TextBlock Text="音乐源" Style="{StaticResource SectionTitle}"/>
            <ItemsControl ItemsSource="{Binding RegisteredSources}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="• " Foreground="{DynamicResource Accent}" FontSize="13"/>
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource FgNormal}" FontSize="13"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 音源插件（外部 .js） -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="音源插件 (.js)" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="把音乐源 .js 插件文件放入 %AppData%\AnMusic\plugins 即可接入新音源（MusicFree 兼容子集）"
                               Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📂 插件文件夹" Style="{StaticResource PageButton}"
                            Command="{Binding OpenPluginFolderCommand}" Margin="0,0,6,0"/>
                    <Button Content="🔄 重新加载" Style="{StaticResource PageButton}"
                            Command="{Binding ReloadPluginsAsyncCommand}"/>
                </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding JsPlugins}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BgControl}" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧩 " FontSize="13"/>
                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource FgNormal}" FontSize="13"/>
                                <TextBlock Text="{Binding Version, StringFormat=  v{0}}" Foreground="{DynamicResource FgMuted}" FontSize="11"/>
                                <TextBlock Text="{Binding FileName, StringFormat=  ({0})}" Foreground="{DynamicResource FgMuted}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding CacheUsageText}" Foreground="{DynamicResource FgMuted}"
                       FontSize="11" Margin="0,10,0,0"/>

            <Button Content="🧹 一键清理全部缓存" HorizontalAlignment="Left"
                    Background="{DynamicResource BgControl}" Foreground="{DynamicResource FgPrimary}"
                    BorderThickness="0" Padding="12,6" FontSize="13" Cursor="Hand"
                    Margin="0,6,0,0" Command="{Binding ClearAllCachesCommand}"
                    ToolTip="清理 B站音频、插件在线歌曲、封面与在线歌词缓存（不影响已下载歌曲和歌单数据）"/>

            <!-- 歌词 -->
            <!-- ===== 分区：Lyrics ===== -->
            </StackPanel>
            <StackPanel Tag="sec:歌词" x:Name="Section_Lyrics">
            <TextBlock Text="歌词" Style="{StaticResource SectionTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="在线歌词 (LRCLIB)" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="默认关闭。启用后本地歌词缺失时，自动从 LRCLIB 开源歌词库（免费、无需密钥）搜索歌词。" Style="{StaticResource SettingDesc}" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox Grid.Column="1" VerticalAlignment="Center"
                          IsChecked="{Binding EnableOnlineLyrics}"/>
            </Grid>

            <!-- 歌词字号 -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="歌词字号" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="调整歌词页正文字体大小" Style="{StaticResource SettingDesc}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LyricFontSize, StringFormat={}{0:F0} px}"
                               Foreground="{DynamicResource FgSecondary}" FontSize="11"
                               HorizontalAlignment="Right"/>
                    <Slider Minimum="12" Maximum="24" Value="{Binding LyricFontSize}"
                            IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True"/>
                </StackPanel>
            </Grid>

            <!-- 歌词颜色 -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="歌词颜色" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="歌词正文文字颜色，当前行保持主题强调色" Style="{StaticResource SettingDesc}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="120" Style="{StaticResource PageCombo}"
                          SelectedIndex="{Binding LyricColorIndex}">
                    <ComboBoxItem Content="跟随主题"/>
                    <ComboBoxItem Content="白色"/>
                    <ComboBoxItem Content="黑色"/>
                    <ComboBoxItem Content="粉色"/>
                    <ComboBoxItem Content="蓝色"/>
                    <ComboBoxItem Content="绿色"/>
                </ComboBox>
            </Grid>

            <!-- 关于 -->
            <!-- ===== 分区：About ===== -->
            </StackPanel>
            <StackPanel Tag="sec:关于" x:Name="Section_About">
            <TextBlock Text="关于" Style="{StaticResource SectionTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="当前版本" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="AnMusic 开源音乐播放器" Style="{StaticResource SettingDesc}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentVersion, StringFormat=v{0}}"
                               Foreground="{DynamicResource FgSecondary}" FontSize="12" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Button Content="{Binding UpdateCheckText}" Style="{StaticResource PageButton}"
                            Command="{Binding CheckForUpdatesCommand}"/>
                </StackPanel>
            </Grid>

            <!-- 用户协议（点击查看） -->
            <!-- ===== 分区：Agreement ===== -->
            </StackPanel>
            <StackPanel Tag="sec:关于" x:Name="Section_Agreement">
            <TextBlock Text="用户协议" Style="{StaticResource SectionTitle}"/>
            <Border Background="{DynamicResource BgControl}" CornerRadius="6" Padding="12,8">
                <Grid>
                    <TextBlock Text="使用本软件即表示您同意《用户协议》，点击右侧按钮查看全文。"
                               Foreground="{DynamicResource FgSecondary}" FontSize="11"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Content="查看" Style="{StaticResource PageButton}"
                            Command="{Binding ShowAgreementCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 免责声明（点击查看） -->
            <!-- ===== 分区：Disclaimer ===== -->
            </StackPanel>
            <StackPanel Tag="sec:关于" x:Name="Section_Disclaimer">
            <TextBlock Text="免责声明" Style="{StaticResource SectionTitle}"/>
            <Border Background="{DynamicResource BgControl}" CornerRadius="6" Padding="12,8">
                <Grid>
                    <TextBlock Text="本软件按&quot;现状&quot;提供，点击右侧按钮查看完整免责声明。"
                               Foreground="{DynamicResource FgSecondary}" FontSize="11"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Content="查看" Style="{StaticResource PageButton}"
                            Command="{Binding ShowDisclaimerCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 联系作者 -->
            <!-- ===== 分区：Contact ===== -->
            </StackPanel>
            <StackPanel Tag="sec:关于" x:Name="Section_Contact">
            <TextBlock Text="联系作者" Style="{StaticResource SectionTitle}"/>
            <Border Background="{DynamicResource BgControl}" CornerRadius="6" Padding="12,10">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="邮箱：835176240@qq.com" Style="{StaticResource SettingLabel}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="发邮件" Style="{StaticResource PageButton}"
                                    Command="{Binding SendEmailCommand}" Margin="0,0,6,0"/>
                            <Button Content="复制" Style="{StaticResource PageButton}"
                                    Command="{Binding CopyEmailCommand}"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <TextBlock Text="交流QQ群：348061212" Style="{StaticResource SettingLabel}"/>
                        <Button Content="复制群号" Style="{StaticResource PageButton}"
                                Command="{Binding CopyQQGroupCommand}"
                                HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 关闭行为 -->
            <!-- ===== 分区：CloseBehavior ===== -->
            </StackPanel>
            <StackPanel Tag="sec:通用" x:Name="Section_CloseBehavior">
            <TextBlock Text="关闭行为" Style="{StaticResource SectionTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="关闭窗口时" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="选择关闭窗口时的默认行为" Style="{StaticResource SettingDesc}"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Width="120" Style="{StaticResource PageCombo}"
                          SelectedIndex="{Binding CloseBehaviorIndex}">
                    <ComboBoxItem Content="每次询问"/>
                    <ComboBoxItem Content="后台运行"/>
                    <ComboBoxItem Content="直接关闭"/>
                </ComboBox>
            </Grid>

            <!-- 状态 -->
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource FgMuted}"
                       FontSize="11" Margin="0,24,0,0"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
