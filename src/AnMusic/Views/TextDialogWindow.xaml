<Window x:Class="AnMusic.Views.TextDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, RelativeSource={RelativeSource Self}}"
        Width="480" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BgMain}"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgPanel}" CornerRadius="8"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ContentText"
                           Foreground="{DynamicResource FgNormal}"
                           FontSize="13" LineHeight="22" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="1" Content="关闭" IsCancel="True" IsDefault="True"
                Padding="24,6" Margin="0,10,0,0" Cursor="Hand"
                HorizontalAlignment="Right"/>
    </Grid>
</Window>
