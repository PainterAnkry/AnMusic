<Window x:Class="AnMusic.Views.DesktopLyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AnMusic.ViewModels"
        mc:Ignorable="d"
        Title="桌面歌词"
        Width="960" Height="140"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowActivated="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick"
        MouseWheel="Window_MouseWheel"
        d:DataContext="{d:DesignInstance Type=vm:LyricViewModel}">
    <Grid>
        <!-- 半透明圆角背景（不透明度可调，由代码后置设置） -->
        <Border x:Name="BgBorder"
                CornerRadius="16"
                Background="#A6000000"
                Margin="8,8,8,8">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
        </Border>

        <!-- 歌词文本容器：三行（上一行/当前行/下一行）+ 译文 -->
        <Grid Margin="16,8,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 上一行 / 下一行：淡显，点击跳转该行 -->
            <TextBlock x:Name="PrevText" Grid.Row="0"
                       Foreground="#FF9C9C9C"
                       FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Cursor="Hand"
                       MouseLeftButtonDown="PrevText_Click">
                <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.7"/></TextBlock.Effect>
            </TextBlock>

            <!-- 当前歌词行 -->
            <TextBlock x:Name="LyricText" Grid.Row="1"
                       Text="{Binding CurrentLineText, FallbackValue=桌面歌词}"
                       Foreground="White"
                       FontSize="30" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       FontFamily="Microsoft YaHei UI">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock x:Name="NextText" Grid.Row="2"
                       Foreground="#FF9C9C9C"
                       FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       Cursor="Hand"
                       MouseLeftButtonDown="NextText_Click">
                <TextBlock.Effect><DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.7"/></TextBlock.Effect>
            </TextBlock>

            <!-- 译文行 -->
            <TextBlock x:Name="TransText" Grid.Row="3"
                        Text="{Binding CurrentLineTranslation}"
                        Foreground="#FFCCCCCC"
                        FontSize="16"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        TextAlignment="Center" TextWrapping="NoWrap"
                        TextTrimming="CharacterEllipsis"
                        Margin="0,4,0,0"
                        FontFamily="Microsoft YaHei UI">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentLineTranslation}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</Window>