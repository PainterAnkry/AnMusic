<Window x:Class="AnMusic.Views.AvatarCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="裁剪头像" Width="520" Height="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgMain}"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource BgPanel}" CornerRadius="8"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Image x:Name="CropImage" Stretch="Uniform" IsHitTestVisible="False"/>
                <Canvas x:Name="CropCanvas" Background="Transparent" ClipToBounds="True"
                        Cursor="Cross"
                        PreviewMouseLeftButtonDown="CropCanvas_MouseDown"
                        PreviewMouseMove="CropCanvas_MouseMove"
                        PreviewMouseLeftButtonUp="CropCanvas_MouseUp">
                    <Ellipse x:Name="SelRect" Stroke="{DynamicResource Accent}" StrokeThickness="1.5"
                             StrokeDashArray="4 2" Fill="#22FFFFFF" Visibility="Collapsed"/>
                </Canvas>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="按住鼠标拖动框选头像区域（自动限定为圆形）"
                       Foreground="{DynamicResource FgMuted}" FontSize="12"
                       VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="重新框选" Click="Reset_Click" Padding="14,6" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="确定" Click="Ok_Click" IsDefault="True" Padding="20,6" Margin="0,0,8,0" Cursor="Hand"/>
                <Button Content="取消" IsCancel="True" Padding="20,6" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
