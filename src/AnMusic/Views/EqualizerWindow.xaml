<Window x:Class="AnMusic.EqualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AnMusic.ViewModels"
        mc:Ignorable="d"
        Title="均衡器" Height="340" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgMain}"
        ResizeMode="NoResize"
        d:DataContext="{d:DesignInstance Type=vm:EqualizerViewModel}">
    <DockPanel Margin="16">
        <!-- 顶部：预设 + 启用 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="预设:" Foreground="{DynamicResource FgPrimary}" FontSize="13"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="PresetCombo" Width="120"
                      ItemsSource="{Binding Presets}"
                      SelectedItem="{Binding SelectedPreset}"
                      DisplayMemberPath="Name"
                      SelectionChanged="PresetCombo_SelectionChanged"/>
            <CheckBox Content="启用" x:Name="EnableCheck"
                      IsChecked="{Binding IsEnabled}"
                      Foreground="{DynamicResource FgPrimary}" FontSize="13"
                      VerticalAlignment="Center" Margin="16,0,0,0"/>
            <Button Content="重置" Click="ResetButton_Click"
                    Background="{DynamicResource BgControl}" Foreground="{DynamicResource FgPrimary}"
                    BorderThickness="0" Padding="12,4" Cursor="Hand"
                    HorizontalAlignment="Right"/>
        </DockPanel>

        <!-- 10 频段滑块 -->
        <UniformGrid Columns="10" Rows="1" Height="200">
            <Border>
                <StackPanel VerticalAlignment="Stretch">
                    <TextBlock Text="{Binding Bands[0].Gain, StringFormat={}{0:F0}dB}"
                               Foreground="{DynamicResource FgSecondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <Slider Orientation="Vertical" HorizontalAlignment="Center"
                            Minimum="-12" Maximum="12" TickFrequency="2"
                            Value="{Binding Bands[0].Gain}" Height="140"/>
                    <TextBlock Text="{Binding Bands[0].Label}" Foreground="{DynamicResource FgPrimary}" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border>
                <StackPanel VerticalAlignment="Stretch">
                    <TextBlock Text="{Binding Bands[1].Gain, StringFormat={}{0:F0}dB}"
                               Foreground="{DynamicResource FgSecondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <Slider Orientation="Vertical" HorizontalAlignment="Center"
                            Minimum="-12" Maximum="12" TickFrequency="2"
                            Value="{Binding Bands[1].Gain}" Height="140"/>
                    <TextBlock Text="{Binding Bands[1].Label}" Foreground="{DynamicResource FgPrimary}" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border>
                <StackPanel VerticalAlignment="Stretch">
                    <TextBlock Text="{Binding Bands[2].Gain, StringFormat={}{0:F0}dB}"
                               Foreground="{DynamicResource FgSecondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <Slider Orientation="Vertical" HorizontalAlignment="Center"
                            Minimum="-12" Maximum="12" TickFrequency="2"
                            Value="{Binding Bands[2].Gain}" Height="140"/>
                    <TextBlock Text="{Binding Bands[2].Label}" Foreground="{DynamicResource FgPrimary}" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border>
                <StackPanel VerticalAlignment="Stretch">
                    <TextBlock Text="{Binding Bands[3].Gain, StringFormat={}{0:F0}dB}"
                               Foreground="{DynamicResource FgSecondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <Slider Orientation="Vertical" HorizontalAlignment="Center"
                            Minimum="-12" Maximum="12" TickFrequency="2"
                            Value="{Binding Bands[3].Gain}" Height="140"/>
                    <TextBlock Text="{Binding Bands[3].Label}" Foreground="{DynamicResource FgPrimary}" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border>
                <StackPanel VerticalAlignment="Stretch">
                    <TextBlock Text="{Binding Bands[4].Gain, StringFormat={}{0:F0}dB}"
                               Foreground="{DynamicResource FgSecondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <Slider Orientation="Vertical" HorizontalAlignment="Center"
                            Minimum="-12" Maximum="12" TickFrequency="2"
                            Value="{Binding Bands[4].Gain}" Height="140"/>
                    <TextBlock Text="{Binding Bands[4].Label}" Foreground="{DynamicResource FgPrimary}" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border>
                <StackPanel VerticalAlignment="Stretch">
                    <TextBlock Text="{Binding Bands[5].Gain, StringFormat={}{0:F0}dB}"
                               Foreground="{DynamicResource FgSecondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <Slider Orientation="Vertical" HorizontalAlignment="Center"
                            Minimum="-12" Maximum="12" TickFrequency="2"
                            Value="{Binding Bands[5].Gain}" Height="140"/>
                    <TextBlock Text="{Binding Bands[5].Label}" Foreground="{DynamicResource FgPrimary}" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border>
                <StackPanel VerticalAlignment="Stretch">
                    <TextBlock Text="{Binding Bands[6].Gain, StringFormat={}{0:F0}dB}"
                               Foreground="{DynamicResource FgSecondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <Slider Orientation="Vertical" HorizontalAlignment="Center"
                            Minimum="-12" Maximum="12" TickFrequency="2"
                            Value="{Binding Bands[6].Gain}" Height="140"/>
                    <TextBlock Text="{Binding Bands[6].Label}" Foreground="{DynamicResource FgPrimary}" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border>
                <StackPanel VerticalAlignment="Stretch">
                    <TextBlock Text="{Binding Bands[7].Gain, StringFormat={}{0:F0}dB}"
                               Foreground="{DynamicResource FgSecondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <Slider Orientation="Vertical" HorizontalAlignment="Center"
                            Minimum="-12" Maximum="12" TickFrequency="2"
                            Value="{Binding Bands[7].Gain}" Height="140"/>
                    <TextBlock Text="{Binding Bands[7].Label}" Foreground="{DynamicResource FgPrimary}" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border>
                <StackPanel VerticalAlignment="Stretch">
                    <TextBlock Text="{Binding Bands[8].Gain, StringFormat={}{0:F0}dB}"
                               Foreground="{DynamicResource FgSecondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <Slider Orientation="Vertical" HorizontalAlignment="Center"
                            Minimum="-12" Maximum="12" TickFrequency="2"
                            Value="{Binding Bands[8].Gain}" Height="140"/>
                    <TextBlock Text="{Binding Bands[8].Label}" Foreground="{DynamicResource FgPrimary}" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border>
                <StackPanel VerticalAlignment="Stretch">
                    <TextBlock Text="{Binding Bands[9].Gain, StringFormat={}{0:F0}dB}"
                               Foreground="{DynamicResource FgSecondary}" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <Slider Orientation="Vertical" HorizontalAlignment="Center"
                            Minimum="-12" Maximum="12" TickFrequency="2"
                            Value="{Binding Bands[9].Gain}" Height="140"/>
                    <TextBlock Text="{Binding Bands[9].Label}" Foreground="{DynamicResource FgPrimary}" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>
    </DockPanel>
</Window>
