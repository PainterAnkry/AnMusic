<Window x:Class="AnMusic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AnMusic.ViewModels"
        xmlns:converters="clr-namespace:AnMusic.Converters"
        xmlns:models="clr-namespace:AnMusic.Models"
        xmlns:controls="clr-namespace:AnMusic.Views.Controls"
        xmlns:pages="clr-namespace:AnMusic.Views.Pages"
        mc:Ignorable="d"
        Title="AnMusic" Height="640" Width="960"
        Icon="pack://application:,,,/AnMusic;component/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource BgMain}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <converters:PathToImageConverter x:Key="PathToImageConv"/>
        <converters:StringNotEmptyToCollapsedConverter x:Key="StrNotEmptyToCollapsed"/>
        <converters:SecondsToTextConverter x:Key="SecondsToTextConv"/>
        <converters:TimeSpanToTextConverter x:Key="TimeSpanToTextConv"/>
        <converters:BoolToPlayTextConverter x:Key="BoolToPlayText"/>
        <converters:BoolToLoadingTextConverter x:Key="BoolToLoadingText"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:StringNotEmptyToVisibilityConverter x:Key="StrNotEmptyToVis"/>
        <converters:SrcLocalCheckedConverter x:Key="SrcLocalCk"/>
        <converters:SrcNeteaseCheckedConverter x:Key="SrcNeteaseCk"/>
        <converters:SrcQQCheckedConverter x:Key="SrcQQCk"/>
        <converters:SrcBiliCheckedConverter x:Key="SrcBiliCk"/>
        <converters:AllFalseToVisibilityConverter x:Key="AllFalseToVis"/>
        <converters:BoolToAccentConverter x:Key="BoolToAccent"/>
        <converters:ProviderIdToVisibilityConverter x:Key="ProviderIdToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- ContextMenu/Popup 不在窗口视觉树中，AncestorType 绑定失效；经代理访问 MainViewModel 命令 -->
        <converters:BindingProxy x:Key="VmProxy" Data="{Binding}"/>

        <!-- 右键菜单：图标单独占一列（定宽居中）+ 文字放 Header。
             以前把 emoji 直接写进 Header 字符串，emoji 的行盒比中文大，图标和文字看着不居中。 -->
        <Style x:Key="MenuIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <Style x:Key="TrackListStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource FgNormal}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <!-- 高 DPI 下按设备像素对齐：行高/封面圆角不会因小数坐标被"顶平" -->
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem Header="播放"
                                  Command="{Binding Data.PlayTrackCommand, Source={StaticResource VmProxy}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><TextBlock Text="&#xE768;" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="下一首播放"
                                  Command="{Binding Data.PlayNextCommand, Source={StaticResource VmProxy}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><TextBlock Text="&#xE893;" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <!-- 仅 B 站曲目：多分P 视频搜索结果只有一条，这里展开全集（分P 列表） -->
                        <MenuItem Header="查看全集（分P）"
                                  Command="{Binding Data.OpenBilibiliPartsCommand, Source={StaticResource VmProxy}}"
                                  CommandParameter="{Binding}"
                                  Visibility="{Binding ProviderId, Converter={StaticResource ProviderIdToVis}, ConverterParameter=bilibili}">
                            <MenuItem.Icon><TextBlock Text="&#xE714;" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="加入/移出 我喜欢"
                                  Command="{Binding Data.ToggleFavoriteCommand, Source={StaticResource VmProxy}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><TextBlock Text="&#xE734;" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="下载到本地"
                                  Command="{Binding Data.DownloadTrackCommand, Source={StaticResource VmProxy}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><TextBlock Text="&#xE896;" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="添加到歌单"
                                  ItemsSource="{Binding Data.UserPlaylists, Source={StaticResource VmProxy}}">
                            <MenuItem.Icon><TextBlock Text="&#xE710;" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Name}"/>
                                    <Setter Property="Command" Value="{Binding Data.AddTrackToPlaylistCommand, Source={StaticResource VmProxy}}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <MenuItem Header="查看歌手"
                                  Command="{Binding Data.ShowArtistCommand, Source={StaticResource VmProxy}}"
                                  CommandParameter="{Binding Artist}">
                            <MenuItem.Icon><TextBlock Text="&#xE77B;" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="查看专辑"
                                  Command="{Binding Data.ShowAlbumCommand, Source={StaticResource VmProxy}}"
                                  CommandParameter="{Binding Album}">
                            <MenuItem.Icon><TextBlock Text="&#xE8F1;" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <!-- 仅本地歌曲视图：选文件加进曲库（路径会记住，重扫目录后仍在）；
                             分隔线跟着它一起显示，避免两个菜单项都隐藏时留下一条空分隔线 -->
                        <Separator Visibility="{Binding Data.IsAllTracksView, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="打开本地文件"
                                  Command="{Binding Data.OpenLocalFilesCommand, Source={StaticResource VmProxy}}"
                                  Visibility="{Binding Data.IsAllTracksView, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVis}}">
                            <MenuItem.Icon><TextBlock Text="&#xE8E5;" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="从歌单中删除"
                                  Command="{Binding Data.RemoveTrackFromPlaylistCommand, Source={StaticResource VmProxy}}"
                                  CommandParameter="{Binding}"
                                  Visibility="{Binding Data.IsPlaylistView, Source={StaticResource VmProxy}, Converter={StaticResource BoolToVis}}">
                            <MenuItem.Icon><TextBlock Text="&#xE738;" Style="{StaticResource MenuIcon}"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgControl}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgControl}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}"/>
        </Style>
        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource FgSidebar}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgControl}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PlayerBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgControl}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgControlHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 播放条“更多”弹层里的菜单行：左对齐、整行可点、悬停高亮 -->
        <Style x:Key="PlayerMenuBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgControl}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表表头排序按钮（全宽无边框，与表头视觉一致） -->
        <Style x:Key="HeaderSortBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 播放队列/下载面板等处的迷你操作按钮（透明无边框） -->
        <Style x:Key="QueueMiniBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 圆形主播放键（科技蓝） -->
        <Style x:Key="PlayPrimaryBtn" TargetType="Button">            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnPrimaryFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 搜索框 -->
        <Style x:Key="SearchBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}"/>
        </Style>
        <!-- 自定义标题栏按钮（齿轮设置 / 最小化 / 最大化 / 关闭） -->
        <Style x:Key="CaptionBtn" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgControl}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseBtn" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 主页卡片：透明底 + 悬停高亮；内容左对齐铺满整格 -->
        <Style x:Key="HomeCardBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgControl}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 主页分区标题 -->
        <Style x:Key="HomeSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 歌词页信息行下方的小胶囊按钮（收藏/下载/桌面歌词/翻译） -->
        <Style x:Key="LyricChip" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgControl}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgControlHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 私信弹层里的小按钮（下载并安装 / 查看完整说明 / 重新检查 / 检查更新） -->
        <Style x:Key="InboxActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgNormal}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 搜索来源筛选标签（搜索框正下方横向标签栏）：选中项高亮 -->
        <Style x:Key="SrcTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="12" Padding="12,4">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource BgControl}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 排行榜子榜单标签（与音源标签同款交互） -->
        <Style x:Key="BoardTab" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="12" Padding="12,4" Margin="0,0,6,0">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource BgControl}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 根 Grid：自定义背景图 + 主布局 -->
    <Grid x:Name="RootGrid" PreviewMouseLeftButtonDown="CloseHistoryPopupIfOutside">
        <!-- 背景图片层（设置页可选，默认隐藏）：当动态壁纸关闭时显示 -->
        <Image Stretch="UniformToFill" IsHitTestVisible="False"
               Source="{Binding Settings.BackgroundImagePath, Converter={StaticResource PathToImageConv}, ConverterParameter=2560}"
               Opacity="{Binding Settings.BackgroundOpacity}">
            <Image.Style>
                <Style TargetType="Image">
                    <Setter Property="Visibility" Value="{Binding Settings.BackgroundImagePath, Converter={StaticResource StrNotEmptyToVis}}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Settings.WallpaperIndex}" Value="1">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Settings.WallpaperIndex}" Value="2">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>

        <!-- 动态壁纸层：WallpaperIndex>0 时显示，模式 = WallpaperIndex（1=鼠标跟随, 2=星河） -->
        <controls:ParticleBackground IsHitTestVisible="False">
            <controls:ParticleBackground.Style>
                <Style TargetType="controls:ParticleBackground">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Setter Property="Mode" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Settings.WallpaperIndex}" Value="1">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Mode" Value="1"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Settings.WallpaperIndex}" Value="2">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Mode" Value="2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:ParticleBackground.Style>
        </controls:ParticleBackground>

        <DockPanel>
        <!-- 自定义标题栏：左标题区（可拖动），右 齿轮设置 + 最小化/最大化/关闭 -->
        <Border DockPanel.Dock="Top" Height="34" Background="{DynamicResource BgPanel}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="pack://application:,,,/AnMusic;component/Assets/app.ico"
                           Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="AnMusic" FontSize="12" Foreground="{DynamicResource FgSecondary}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <!-- 用户入口：仅头像，点击展开资料下拉面板（昵称/等级/经验在面板内查看与修改） -->
                    <Button x:Name="UserButton" Click="UserButton_Click" Style="{StaticResource CaptionBtn}"
                            Width="44" Height="34" ToolTip="个人资料">
                        <Grid Width="24" Height="24" VerticalAlignment="Center">
                            <TextBlock Text="👤" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource FgSecondary}"
                                       Visibility="{Binding UserAvatarPath, Converter={StaticResource StrNotEmptyToCollapsed}}"/>
                            <!-- 双层：内层头像圆（精确填满居中），外层描边圆不叠压图像 -->
                            <Ellipse Width="21" Height="21" StrokeThickness="0">
                                <Ellipse.Fill>
                                    <!-- UniformToFill 等比放大并居中：非方形图片也不会拉伸/偏移 -->
                                    <ImageBrush Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center">
                                        <ImageBrush.ImageSource>
                                            <Binding Path="UserAvatarPath" Converter="{StaticResource PathToImageConv}" ConverterParameter="128"/>
                                        </ImageBrush.ImageSource>
                                    </ImageBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="24" Height="24" Stroke="{DynamicResource Accent}" StrokeThickness="1" Fill="Transparent"/>
                        </Grid>
                    </Button>
                    <!-- 用户资料下拉面板：头像裁剪 + 昵称编辑 + 等级/经验进度 -->
                    <Popup x:Name="UserPopup" PlacementTarget="{Binding ElementName=UserButton}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource BgPanel}" CornerRadius="10"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                Width="240" Margin="0,4,8,8" Padding="16,14">
                            <StackPanel>
                                <Border Width="64" Height="64" CornerRadius="32" Cursor="Hand"
                                        Background="{DynamicResource BgControl}" HorizontalAlignment="Center"
                                        MouseLeftButtonDown="PopupAvatar_Click" ToolTip="点击更换头像（支持自由裁剪）">
                                    <Grid>
                                        <TextBlock Text="👤" FontSize="26" Foreground="{DynamicResource FgMuted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding UserAvatarPath, Converter={StaticResource StrNotEmptyToCollapsed}}"/>
                                        <!-- 头像圆：显式尺寸填满圆框（UniformToFill 等比居中），PNG 四角透明与圆框一致 -->
                                        <Ellipse Width="58" Height="58">
                                            <Ellipse.Fill>
                                                <ImageBrush Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center">
                                                    <ImageBrush.ImageSource>
                                                        <Binding Path="UserAvatarPath" Converter="{StaticResource PathToImageConv}" ConverterParameter="128"/>
                                                    </ImageBrush.ImageSource>
                                                </ImageBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                </Border>
                                <TextBlock Text="点击头像更换（支持裁剪）" FontSize="10"
                                           Foreground="{DynamicResource FgMuted}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                <TextBlock Text="昵称" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,12,0,4"/>
                                <TextBox Text="{Binding UserNickname, UpdateSourceTrigger=LostFocus}" FontSize="12"
                                         Background="{DynamicResource BgControl}" Foreground="{DynamicResource FgPrimary}"
                                         BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                         Padding="8,6" ToolTip="修改后自动保存"/>
                                <DockPanel Margin="0,14,0,4">
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource Accent}" CornerRadius="6" Padding="5,1">
                                        <TextBlock Text="{Binding UserLevel, StringFormat=Lv.{0}}"
                                                   Foreground="White" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="听歌等级" FontSize="11" Foreground="{DynamicResource FgMuted}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <ProgressBar Height="6" Minimum="0" Maximum="100"
                                             Value="{Binding UserLevelProgressValue, Mode=OneWay}"
                                             Foreground="{DynamicResource Accent}"
                                             Background="{DynamicResource BgControl}" BorderThickness="0"/>
                                <TextBlock Text="{Binding UserLevelProgress}" FontSize="10"
                                           Foreground="{DynamicResource FgMuted}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding TotalListeningText, StringFormat=累计听歌 {0}}" FontSize="10"
                                           Foreground="{DynamicResource FgMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <!-- 私信：版本升级等应用内通知（有未读时右上角亮小圆点） -->
                    <Button x:Name="InboxButton" Style="{StaticResource CaptionBtn}" Click="InboxButton_Click"
                            ToolTip="{Binding Inbox.ToolTipText}">
                        <Grid Width="24" Height="34">
                            <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentWarm}"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,2,0"
                                     Visibility="{Binding Inbox.HasUnread, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Button>
                    <Popup x:Name="InboxPopup" PlacementTarget="{Binding ElementName=InboxButton}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource BgPanel}" CornerRadius="10"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                Padding="14,12" Margin="0,4,8,8" Width="340">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Inbox.CurrentVersion, StringFormat=v{0}}"
                                               Foreground="{DynamicResource FgMuted}" FontSize="10.5"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="私信" Foreground="{DynamicResource FgPrimary}"
                                               FontWeight="Bold" FontSize="13"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Inbox.SummaryText}" Foreground="{DynamicResource FgMuted}"
                                           FontSize="10.5" Margin="0,2,0,8"/>

                                <!-- 消息卡片：图标 + 标题 + 正文（超长可滚动）+ 操作按钮 -->
                                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Inbox.Messages}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource BgControl}" CornerRadius="8"
                                                        Padding="10,9" Margin="0,0,0,8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Style.Triggers>
                                                                <!-- 重要公告：强调色描边 -->
                                                                <DataTrigger Binding="{Binding IsImportant}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}"
                                                                       Foreground="{DynamicResource FgMuted}" FontSize="10"
                                                                       VerticalAlignment="Center"/>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentWarm}"
                                                                         VerticalAlignment="Center" Margin="0,0,6,0"
                                                                         Visibility="{Binding IsUnread, Converter={StaticResource BoolToVis}}"/>
                                                                <TextBlock Text="{Binding Icon}" FontSize="12"
                                                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12.5"
                                                                           Foreground="{DynamicResource FgPrimary}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Body}" Foreground="{DynamicResource FgSecondary}"
                                                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                   LineHeight="17"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                                    Visibility="{Binding HasActions, Converter={StaticResource BoolToVis}}">
                                                            <Button Content="⬇ 下载并安装" Style="{StaticResource InboxActionBtn}"
                                                                    Command="{Binding Data.Inbox.InstallCommand, Source={StaticResource VmProxy}}"
                                                                    Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="下载安装包，完成后启动安装向导（歌单/收藏/设置都保留）"/>
                                                            <Button Content="{Binding LinkText}" Style="{StaticResource InboxActionBtn}"
                                                                    Margin="6,0,0,0"
                                                                    Command="{Binding Data.Inbox.OpenReleaseCommand, Source={StaticResource VmProxy}}"
                                                                    CommandParameter="{Binding ReleaseUrl}"
                                                                    Visibility="{Binding ReleaseUrl, Converter={StaticResource StrNotEmptyToVis}}"/>
                                                            <Button Content="重新检查" Style="{StaticResource InboxActionBtn}"
                                                                    Command="{Binding Data.Inbox.CheckCommand, Source={StaticResource VmProxy}}"
                                                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <DockPanel Margin="0,2,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Inbox.StatusText}"
                                               Foreground="{DynamicResource FgMuted}" FontSize="10.5"
                                               VerticalAlignment="Center"/>
                                    <Button Content="检查更新" Style="{StaticResource InboxActionBtn}"
                                            Command="{Binding Inbox.CheckCommand}"
                                            IsEnabled="{Binding Inbox.CanCheck}"
                                            ToolTip="到 GitHub 查询最新版本"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <!-- 皮肤：标题栏快捷入口，弹层里点格子即换肤 -->
                    <Button x:Name="SkinButton" Style="{StaticResource CaptionBtn}" Click="SkinButton_Click" ToolTip="皮肤">
                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Popup x:Name="SkinPopup" PlacementTarget="{Binding ElementName=SkinButton}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource BgPanel}" CornerRadius="10"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                Padding="12" Margin="0,4,8,8" Width="286">
                            <StackPanel>
                                <TextBlock Text="皮肤" Foreground="{DynamicResource FgPrimary}"
                                           FontWeight="Bold" FontSize="13" Margin="2,0,0,2"/>
                                <TextBlock Text="点击方块立即切换（底色 + 强调色）" Foreground="{DynamicResource FgMuted}"
                                           FontSize="10.5" Margin="2,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Settings.Skins}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding Data.Settings.SelectSkinCommand, Source={StaticResource VmProxy}}"
                                                    CommandParameter="{Binding}"
                                                    Click="SkinOption_Click"
                                                    Background="Transparent" BorderThickness="0"
                                                    Padding="0" Margin="0,0,6,6" Cursor="Hand"
                                                    ToolTip="{Binding Name}">
                                                <StackPanel Width="60">
                                                    <Border Height="36" CornerRadius="8"
                                                            Background="{Binding PreviewBackground}"
                                                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Ellipse Width="13" Height="13" Fill="{Binding PreviewAccent}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <TextBlock Text="✓" FontSize="12" Foreground="White"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                       Margin="0,2,4,0"
                                                                       Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="10.5" Margin="0,3,0,0"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource FgSecondary}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Style="{StaticResource CaptionBtn}" Click="SettingsButton_Click" ToolTip="设置">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource CaptionBtn}" Click="MinimizeButton_Click" ToolTip="最小化">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button Style="{StaticResource CaptionBtn}" Click="MaximizeButton_Click" ToolTip="最大化/还原">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE922;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Text" Value="&#xE923;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource CaptionCloseBtn}" Click="CloseButton_Click" ToolTip="关闭">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 底部播放控制栏 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgPanel}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左：封面 + 曲目信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 封面：无封面时显示占位符，仍可点击进歌词 -->
                    <Border CornerRadius="6" Width="52" Height="52" Cursor="Hand"
                            Background="{DynamicResource BgControl}"
                            MouseLeftButtonDown="PlayBarCover_Click"
                            ToolTip="点击打开/关闭歌词" Margin="0,0,10,0">
                        <Grid>
                            <TextBlock Text="🎵" FontSize="22"
                                       Foreground="{DynamicResource FgMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="PlayBarCover" Width="48" Height="48" Stretch="Uniform">
                                <Image.Source>
                                    <Binding Path="PlaybackBar.CoverPath" Converter="{StaticResource PathToImageConv}" ConverterParameter="96"/>
                                </Image.Source>
                            </Image>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlaybackBar.CurrentTitle}" Foreground="{DynamicResource FgPrimary}"
                                   FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PlaybackBar.CurrentArtist}" Foreground="{DynamicResource FgSecondary}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                            <TextBlock Text="⏳ 缓冲中" Foreground="{DynamicResource AccentWarm}" FontSize="11"
                                       Margin="6,0,0,0"
                                       Visibility="{Binding PlaybackBar.IsBuffering, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 中：播放控制 + 进度条 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <!-- 播放模式：顺序 ➡ → 列表循环 🔁 → 单曲循环 🔂 → 随机 🔀 -->
                        <Button Content="{Binding PlaybackBar.PlayModeIcon}"
                                ToolTip="{Binding PlaybackBar.PlayModeTip}" Margin="0,0,8,0"
                                Foreground="{DynamicResource Accent}"
                                Command="{Binding PlaybackBar.CyclePlayModeCommand}"
                                Style="{StaticResource PlayerBtn}"/>
                        <Button Content="⏮" Style="{StaticResource PlayerBtn}" Margin="0,0,10,0"
                                Command="{Binding PlaybackBar.PreviousCommand}"/>
                        <Button Content="{Binding PlaybackBar.IsPlaying, Converter={StaticResource BoolToPlayText}}"
                                Command="{Binding PlaybackBar.PlayPauseCommand}"
                                Style="{StaticResource PlayPrimaryBtn}" Margin="0,0,10,0"/>
                        <Button Content="⏭" Style="{StaticResource PlayerBtn}" Margin="0,0,8,0"
                                Command="{Binding PlaybackBar.NextCommand}"/>

                        <!-- 播放队列：完整队列管理（双击播放 / 调整顺序 / 移除） -->
                        <Button x:Name="UpNextButton" Content="📃" ToolTip="播放队列" Margin="0,0,8,0"
                                Style="{StaticResource PlayerBtn}"
                                Click="UpNextButton_Click"/>
                        <Popup x:Name="QueuePopup" PlacementTarget="{Binding ElementName=UpNextButton}"
                               Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource BgPanel}" CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    Padding="12,10" MinWidth="340" MaxHeight="430" Margin="0,0,0,8">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="播放队列 · 双击播放，↑↓ 调序，✕ 移除（当前曲目不可移除）"
                                               FontWeight="Bold" FontSize="12"
                                               Foreground="{DynamicResource FgPrimary}" Margin="0,0,0,6"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ListBox x:Name="QueueList" ItemsSource="{Binding QueueRows}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 MouseDoubleClick="QueueList_MouseDoubleClick">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Padding" Value="2"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Focusable" Value="False"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- 当前曲目指示 -->
                                                        <TextBlock Grid.Column="0" Text="▶" FontSize="10"
                                                                   Foreground="{DynamicResource Accent}"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <!-- 标题 / 歌手 -->
                                                        <TextBlock Grid.Column="1" FontSize="12"
                                                                   Foreground="{DynamicResource FgNormal}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Track.Title}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource FgNormal}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                            <Run Text="{Binding Track.Title, Mode=OneWay}"/>
                                                            <Run Text=" - " Foreground="{DynamicResource FgMuted}"/>
                                                            <Run Text="{Binding Track.Artist, Mode=OneWay}" Foreground="{DynamicResource FgMuted}"/>
                                                        </TextBlock>
                                                        <!-- 操作按钮 -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                                            <Button Content="↑" ToolTip="上移" Command="{Binding Data.MoveQueueTrackUpCommand, Source={StaticResource VmProxy}}"
                                                                    CommandParameter="{Binding Track}"
                                                                    Style="{StaticResource QueueMiniBtn}"/>
                                                            <Button Content="↓" ToolTip="下移" Command="{Binding Data.MoveQueueTrackDownCommand, Source={StaticResource VmProxy}}"
                                                                    CommandParameter="{Binding Track}"
                                                                    Style="{StaticResource QueueMiniBtn}"/>
                                                            <Button Content="✕" ToolTip="从队列移除" Command="{Binding Data.RemoveQueueTrackCommand, Source={StaticResource VmProxy}}"
                                                                    CommandParameter="{Binding Track}"
                                                                    Style="{StaticResource QueueMiniBtn}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                    <!-- 进度条 + 爱心收藏 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 爱心收藏：空心未收藏 / 实心已收藏，点击切换 -->
                        <Button Grid.Column="0" Command="{Binding ToggleCurrentFavoriteCommand}"
                                Style="{StaticResource PlayerBtn}" Margin="0,0,8,0"
                                ToolTip="加入/移出我喜欢" FontSize="16" VerticalAlignment="Center">
                            <Button.Content>
                                <TextBlock FontFamily="Segoe MDL2 Assets">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE006;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentFavorited}" Value="True">
                                                    <Setter Property="Text" Value="&#xEB51;"/>
                                                    <Setter Property="Foreground" Value="#E91E63"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding PlaybackBar.PositionSeconds, Converter={StaticResource SecondsToTextConv}}"
                                   Foreground="{DynamicResource FgSecondary}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider Grid.Column="2" x:Name="ProgressSlider"
                                Minimum="0" Maximum="{Binding PlaybackBar.DurationSeconds}"
                                Value="{Binding PlaybackBar.PositionSeconds}"
                                PreviewMouseLeftButtonDown="ProgressSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="ProgressSlider_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp"
                                Thumb.DragStarted="ProgressSlider_DragStarted"
                                Thumb.DragCompleted="ProgressSlider_DragCompleted"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding PlaybackBar.DurationSeconds, Converter={StaticResource SecondsToTextConv}}"
                                   Foreground="{DynamicResource FgSecondary}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>

                <!-- 右：音量 + EQ -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="🎛" Click="EqButton_Click" Style="{StaticResource PlayerBtn}"
                            Margin="0,0,8,0" ToolTip="均衡器"/>
                    <TextBlock Text="🔊" Foreground="{DynamicResource FgSecondary}" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider Width="80" Minimum="0" Maximum="1"
                            Value="{Binding PlaybackBar.Volume}"
                            IsMoveToPointEnabled="True"
                            VerticalAlignment="Center"/>
                    <!-- 词：弹出/收起歌词页 -->
                    <Button Content="词" Command="{Binding ToggleLyricsCommand}"
                            Style="{StaticResource PlayerBtn}" FontSize="13"
                            Margin="8,0,0,0" ToolTip="歌词"/>
                    <!-- 更多：桌面歌词 / 一起听 / 迷你悬浮卡片 -->
                    <Button x:Name="MoreBtn" Content="⋯" Click="MoreButton_Click"
                            Style="{StaticResource PlayerBtn}" FontSize="17"
                            Margin="8,0,0,0" ToolTip="更多：桌面歌词 / 一起听 / 迷你悬浮卡片"/>
                    <Popup x:Name="MorePopup" PlacementTarget="{Binding ElementName=MoreBtn}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource BgPanel}" CornerRadius="10"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                Padding="6" Margin="0,0,0,8" MinWidth="188">
                            <StackPanel>
                                <Button Click="MoreDesktopLyrics_Click" Style="{StaticResource PlayerMenuBtn}"
                                        ToolTip="显示/隐藏独立的桌面歌词悬浮窗">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="✓" FontSize="12" Margin="10,0,0,0"
                                                   Foreground="{DynamicResource Accent}"
                                                   Visibility="{Binding IsDesktopLyricsOpen, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="🖥  桌面歌词" FontSize="12.5"
                                                   Foreground="{DynamicResource FgNormal}"/>
                                    </DockPanel>
                                </Button>
                                <Button Click="MoreListenTogether_Click" Style="{StaticResource PlayerMenuBtn}"
                                        ToolTip="和其他人一起听同一首歌">
                                    <TextBlock Text="🎧  一起听" FontSize="12.5"
                                               Foreground="{DynamicResource FgNormal}"/>
                                </Button>
                                <Button Click="MoreMiniPlayer_Click" Style="{StaticResource PlayerMenuBtn}"
                                        ToolTip="极简悬浮小卡片播放器（开启后主窗口最小化）">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="✓" FontSize="12" Margin="10,0,0,0"
                                                   Foreground="{DynamicResource Accent}"
                                                   Visibility="{Binding IsMiniPlayerOpen, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="📻  迷你悬浮卡片" FontSize="12.5"
                                                   Foreground="{DynamicResource FgNormal}"/>
                                    </DockPanel>
                                </Button>
                                <Button Click="MoreShare_Click" Style="{StaticResource PlayerMenuBtn}"
                                        ToolTip="把当前歌曲的歌名/歌手/链接复制到剪贴板">
                                    <TextBlock Text="🔗  分享当前歌曲" FontSize="12.5"
                                               Foreground="{DynamicResource FgNormal}"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Popup x:Name="ListenTogetherPopup"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <controls:ListenTogetherPanel DataContext="{Binding ListenTogether}"/>
                    </Popup>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 顶部工具栏：品牌 + 搜索框 + 来源切换 + 设置（歌词页/播放器模式下收起） -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}" Padding="16,10"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsMainChromeVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左：品牌 + 全局前进/返回导航 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AnMusic" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <!-- 全局返回按钮 -->
                    <Button Command="{Binding GoBackCommand}" Style="{StaticResource PlayerBtn}"
                            Width="32" Height="32" FontSize="14" ToolTip="返回"
                            IsEnabled="{Binding CanGoBack}">
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                    <!-- 全局前进按钮 -->
                    <Button Command="{Binding GoForwardCommand}" Style="{StaticResource PlayerBtn}"
                            Width="32" Height="32" FontSize="14" ToolTip="前进" Margin="6,0,0,0"
                            IsEnabled="{Binding CanGoForward}">
                        <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                </StackPanel>

                <!-- 中：搜索框（正下方为音源筛选标签栏） -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- 搜索框 -->
                        <Border x:Name="SearchBoxBorder" Background="{DynamicResource BgControl}"
                                CornerRadius="20" Padding="14,6" MinWidth="260">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="🔍" Style="{StaticResource SearchBtn}"
                                        FontSize="14" Margin="4,0,0,0"
                                        Command="{Binding SearchCommand}" ToolTip="搜索"/>
                                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource FgPrimary}"
                                         VerticalContentAlignment="Center" FontSize="13"
                                         KeyDown="SearchTextBox_KeyDown"
                                         GotKeyboardFocus="SearchBox_GotFocus"
                                         ToolTip="输入关键词，回车搜索"/>
                            </DockPanel>
                        </Border>
                        <!-- 搜索历史（聚焦搜索框时下拉，点击外部关闭） -->
                        <Popup x:Name="HistoryPopup" PlacementTarget="{Binding ElementName=SearchBoxBorder}" Placement="Bottom"
                               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{DynamicResource BgPanel}" CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    Margin="0,2,0,8" Width="260" Padding="6"
                                    Visibility="{Binding ElementName=HistoryList, Path=HasItems, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <ItemsControl x:Name="HistoryList" ItemsSource="{Binding SearchHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button HorizontalContentAlignment="Left"
                                                        Style="{StaticResource SearchBtn}" Padding="10,6" FontSize="12"
                                                        Click="HistoryItem_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="🕘 " Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="清空搜索历史" Style="{StaticResource SearchBtn}" Padding="10,6"
                                            FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource FgMuted}"
                                            Click="ClearHistory_Click"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                    <!-- 音源筛选标签栏：本地 / 网易云 / QQ音乐 / B站（选中高亮） -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <RadioButton Content="本地" GroupName="Src" Style="{StaticResource SrcTab}"
                                     IsChecked="{Binding SearchSource, Converter={StaticResource SrcLocalCk}, Mode=TwoWay}"/>
                        <RadioButton Content="网易云" GroupName="Src" Style="{StaticResource SrcTab}"
                                     IsChecked="{Binding SearchSource, Converter={StaticResource SrcNeteaseCk}, Mode=TwoWay}"/>
                        <RadioButton Content="QQ音乐" GroupName="Src" Style="{StaticResource SrcTab}"
                                     IsChecked="{Binding SearchSource, Converter={StaticResource SrcQQCk}, Mode=TwoWay}"/>
                        <RadioButton Content="B站" GroupName="Src" Style="{StaticResource SrcTab}"
                                     IsChecked="{Binding SearchSource, Converter={StaticResource SrcBiliCk}, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右：状态 + 设置 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Library.StatusText}" Foreground="{DynamicResource FgSecondary}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Library.IsLoading, Converter={StaticResource BoolToLoadingText}}"
                               Foreground="{DynamicResource Accent}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区：侧边栏 + 内容 + 歌词覆盖层 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧边栏（MusicFree 风格）；歌词页/播放器模式下收起 -->
            <Border Grid.Column="0" Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsMainChromeVisible, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="8,10,8,10">
                    <!-- 我的歌单标题 + 新建/导入 -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="4,14,4,4">
                        <Button DockPanel.Dock="Right" Content="＋" Click="CreatePlaylistButton_Click"
                                Background="Transparent" Foreground="{DynamicResource FgSecondary}"
                                BorderThickness="0" FontSize="14" Cursor="Hand"
                                ToolTip="新建歌单" Padding="6,0"/>
                        <Button DockPanel.Dock="Right" Content="⇩" Click="ImportPlaylistButton_Click"
                                Background="Transparent" Foreground="{DynamicResource FgSecondary}"
                                BorderThickness="0" FontSize="13" Cursor="Hand" Margin="0,0,10,0"
                                ToolTip="从网易云/QQ音乐歌单链接导入" Padding="4,0"/>
                        <TextBlock Text="我的歌单" Foreground="{DynamicResource FgMuted}"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <!-- 歌单列表（固定在底部上方） -->
                    <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <!-- 空状态：暂无歌单时提示新建/导入 -->
                        <TextBlock Text="还没有歌单&#x0a;点上方 ＋ 新建，或 ⇩ 导入"
                                   Foreground="{DynamicResource FgMuted}" FontSize="11"
                                   TextAlignment="Center" LineHeight="18" Margin="0,6,0,8"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UserPlaylists.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding UserPlaylists}" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,6" Cursor="Hand"
                                            MouseLeftButtonDown="SidebarPlaylist_Click" ToolTip="打开歌单">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="🖼  设置自定义封面"
                                                          Command="{Binding Data.ChoosePlaylistCoverCommand, Source={StaticResource VmProxy}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="↺  恢复默认封面（最近添加的歌曲）"
                                                          Command="{Binding Data.ResetPlaylistCoverCommand, Source={StaticResource VmProxy}}"
                                                          CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="✏  重命名歌单" Click="RenamePlaylist_Click"/>
                                                <MenuItem Header="⬆  批量导入歌曲"
                                                          Command="{Binding Data.ImportTracksToPlaylistCommand, Source={StaticResource VmProxy}}"
                                                          CommandParameter="{Binding}"/>
                                                <MenuItem Header="🗑  删除歌单"
                                                          Command="{Binding Data.DeletePlaylistCommand, Source={StaticResource VmProxy}}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource BgControl}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <!-- 封面：自定义封面优先，否则用最近添加的歌曲封面（随封面缓存异步刷新） -->
                                            <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="4"
                                                    Background="{DynamicResource BgControl}" Margin="0,0,8,0">
                                                <Grid>
                                                    <TextBlock Text="🎵" FontSize="11" Foreground="{DynamicResource FgMuted}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Border CornerRadius="4"
                                                            Visibility="{Binding CoverPath, Converter={StaticResource StrNotEmptyToCollapsed}}">
                                                        <Border.Background>
                                                            <ImageBrush Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"
                                                                        ImageSource="{Binding DefaultCoverTrack.CoverKey, Converter={StaticResource PathToImageConv}, ConverterParameter=64}"/>
                                                        </Border.Background>
                                                    </Border>
                                                    <Border CornerRadius="4"
                                                            Visibility="{Binding CoverPath, Converter={StaticResource StrNotEmptyToVis}}">
                                                        <Border.Background>
                                                            <ImageBrush Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"
                                                                        ImageSource="{Binding CoverPath, Converter={StaticResource PathToImageConv}, ConverterParameter=64}"/>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource FgNormal}"
                                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                    <!-- 导航项：上组 = 发现（排行榜/听歌排行/个性电台） -->
                    <StackPanel>
                        <Border Background="{DynamicResource BgMainAlpha}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                Padding="4" Margin="0,0,0,10">
                            <StackPanel>
                                <Button Command="{Binding ShowHomeCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                            <Setter Property="Content" Value="🏠  主页"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHomeView}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding ShowRankingCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                            <Setter Property="Content" Value="🏆  排行榜"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRankingView}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding ShowListeningStatsCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                            <Setter Property="Content" Value="📊  听歌排行"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsListeningStatsView}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding ShowRadioCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                            <Setter Property="Content" Value="📻  个性电台"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRadioView}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- 下载管理：独立页面（与排行榜同级） -->
                                <Button Command="{Binding ShowDownloadsCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                            <Setter Property="Content" Value="📥  下载管理"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDownloadView}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                        <!-- 下组 = 我的音乐（搜索结果/全部音乐/最近播放/我喜欢） -->
                        <Border Background="{DynamicResource BgMainAlpha}" CornerRadius="8"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                Padding="4">
                            <StackPanel>
                                <Button Command="{Binding ShowSearchCommand}"
                                        Visibility="{Binding IsSearchSectionVisible, Converter={StaticResource BoolToVis}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                            <Setter Property="Content" Value="🔍  搜索结果"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSearchSectionVisible}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding ShowAllTracksCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                            <Setter Property="Content" Value="🎵  本地歌曲"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAllTracksView}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding ShowRecentCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                            <Setter Property="Content" Value="🕐  最近播放"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecentView}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding ShowFavoritesCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarBtn}">
                                            <Setter Property="Content" Value="❤  我喜欢"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavoritesView}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 内容区（标题行/状态条/曲目列表）；设置页或歌词页打开时整体隐藏，避免透过半透明页面显示 -->
            <Grid Grid.Column="1" x:Name="ContentGrid"
                  Visibility="{Binding IsContentAreaVisible, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 视图标题栏：不透明背景，避免左右缝隙透出底层背景图
                     （歌手页/专辑页用自己的大头部，这里整体收起） -->
                <Border Grid.Row="0" Background="{DynamicResource BgPanel}" Padding="16,10"
                        Visibility="{Binding IsDetailHeaderVisible, Converter={StaticResource InvBoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    Visibility="{Binding IsHomeView, Converter={StaticResource InvBoolToVis}}">
                            <!-- 仅本地歌曲视图：直接选文件加入曲库（路径会记住，重扫目录后仍在） -->
                            <Button Content="📄 打开本地文件" Command="{Binding OpenLocalFilesCommand}"
                                    Style="{StaticResource BtnStyle}" Margin="0,0,8,0"
                                    Visibility="{Binding IsAllTracksView, Converter={StaticResource BoolToVis}}"
                                    ToolTip="选择一个或多个本地音频文件加入「本地歌曲」"/>
                            <Button Content="📂 打开文件夹" Command="{Binding Library.SelectDirectoryCommand}"
                                    Style="{StaticResource BtnStyle}" Margin="0,0,8,0"/>
                            <Button Content="▶ 播放全部"
                                    Command="{Binding PlayAllCurrentCommand}" Style="{StaticResource BtnStyle}"/>
                        </StackPanel>
                        <!-- 当前列表过滤（不改变数据，可与表头排序叠加）；主页没有列表，隐藏 -->
                        <Border DockPanel.Dock="Right" Width="180" Margin="0,0,10,0"
                                Background="{DynamicResource BgControl}" CornerRadius="10" Padding="8,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsHomeView, Converter={StaticResource InvBoolToVis}}">
                            <Grid>
                                <TextBlock Text="🔍 过滤当前列表" Foreground="{DynamicResource FgMuted}"
                                           FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ListFilterText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="FilterBox"
                                         Text="{Binding ListFilterText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource FgPrimary}" FontSize="11"
                                         VerticalContentAlignment="Center"
                                         TextChanged="FilterBox_TextChanged"
                                         KeyDown="FilterBox_KeyDown"
                                         ToolTip="按歌名/歌手/专辑过滤当前列表（不影响数据）；Esc 清除"/>
                            </Grid>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentViewTitle}" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>
                            <!-- 曲目条数：主页没有曲目列表，不显示"0 首" -->
                            <TextBlock Text="{Binding CurrentTracks.Count, StringFormat={}{0} 首}" FontSize="12"
                                       Foreground="{DynamicResource FgMuted}" VerticalAlignment="Center" Margin="10,2,0,0"
                                       Visibility="{Binding IsHomeView, Converter={StaticResource InvBoolToVis}}"/>
                            <!-- 按时段问候（清晨/午后/黄昏/深夜，随时间自动刷新） -->
                            <TextBlock Text="{Binding Greeting}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource FgMuted}" VerticalAlignment="Center"
                                       Margin="16,2,12,0" MaxWidth="360" ToolTip="{Binding Greeting}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 歌手页头部：圆形头像 + 名称 + 单曲/专辑数 + 播放全部 -->
                <Border Grid.Row="0" Background="{DynamicResource BgPanel}" Padding="16,14"
                        Visibility="{Binding IsArtistView, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="▶ 播放全部" Command="{Binding PlayAllCurrentCommand}"
                                    Style="{StaticResource BtnStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!-- 圆形头像：该歌手第一首有封面的歌；没有封面时是占位 -->
                            <Grid Width="96" Height="96">
                                <Ellipse Fill="{DynamicResource BgControl}"/>
                                <TextBlock Text="🎤" FontSize="30" Foreground="{DynamicResource FgMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush Stretch="UniformToFill"
                                                    ImageSource="{Binding ArtistCoverKey, Converter={StaticResource PathToImageConv}, ConverterParameter=180}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="{Binding ArtistName}" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource FgPrimary}" TextTrimming="CharacterEllipsis"
                                           MaxWidth="420" ToolTip="{Binding ArtistName}"/>
                                <TextBlock Text="{Binding ArtistMeta}" FontSize="12"
                                           Foreground="{DynamicResource FgMuted}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 专辑页头部：封面 + 名称 + 歌手/曲目数 + 播放全部 -->
                <Border Grid.Row="0" Background="{DynamicResource BgPanel}" Padding="16,14"
                        Visibility="{Binding IsAlbumView, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="▶ 播放全部" Command="{Binding PlayAllCurrentCommand}"
                                    Style="{StaticResource BtnStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!-- 方形圆角封面：专辑内第一首有封面的歌 -->
                            <Grid Width="96" Height="96">
                                <Rectangle RadiusX="10" RadiusY="10" Fill="{DynamicResource BgControl}"/>
                                <TextBlock Text="💿" FontSize="30" Foreground="{DynamicResource FgMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Rectangle RadiusX="10" RadiusY="10">
                                    <Rectangle.Fill>
                                        <ImageBrush Stretch="UniformToFill"
                                                    ImageSource="{Binding AlbumCoverKey, Converter={StaticResource PathToImageConv}, ConverterParameter=180}"/>
                                    </Rectangle.Fill>
                                </Rectangle>
                            </Grid>
                            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="{Binding AlbumName}" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource FgPrimary}" TextTrimming="CharacterEllipsis"
                                           MaxWidth="420" ToolTip="{Binding AlbumName}"/>
                                <TextBlock Text="{Binding AlbumMeta}" FontSize="12"
                                           Foreground="{DynamicResource FgMuted}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 搜索结果分类：综合 / 单曲 / 歌手 / 专辑 -->
                <Border Grid.Row="1" Background="{DynamicResource BgPanel}" Padding="16,0"
                        Visibility="{Binding IsSearchTabsVisible, Converter={StaticResource BoolToVis}}">
                    <ListBox ItemsSource="{Binding SearchTabNames}"
                             SelectedIndex="{Binding SearchTabIndex, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Margin="0,4,0,6">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource BoardTab}"/>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>

                <!-- 歌手页页签：歌曲 / 专辑 -->
                <Border Grid.Row="1" Background="{DynamicResource BgPanel}" Padding="16,0"
                        Visibility="{Binding IsArtistView, Converter={StaticResource BoolToVis}}">
                    <ListBox ItemsSource="{Binding ArtistTabNames}"
                             SelectedIndex="{Binding ArtistTabIndex, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Margin="0,4,0,6">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource BoardTab}"/>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>

                <!-- 排行榜子榜单切换行（仅排行榜视图显示） -->
                <Border Grid.Row="1" Background="{DynamicResource BgPanel}" Padding="16,2"
                        Visibility="{Binding IsRankingView, Converter={StaticResource BoolToVis}}">
                    <ListBox ItemsSource="{Binding RankingBoardNames}"
                             SelectedItem="{Binding SelectedRankingBoard, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Margin="0,4,0,6">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource BoardTab}"/>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>

                <!-- B 站分P 全集说明行（仅该视图显示）：来源视频 + 返回入口 -->
                <Border Grid.Row="1" Background="{DynamicResource BgPanel}" Padding="16,6"
                        Visibility="{Binding IsBilibiliPartsView, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Command="{Binding GoBackCommand}"
                                Style="{StaticResource PlayerBtn}" Height="26" FontSize="12"
                                Padding="10,0" Margin="0,0,12,0" ToolTip="返回上一个页面（搜索结果/歌单…）">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="返回" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding BilibiliPartsHeader}" Foreground="{DynamicResource FgSecondary}"
                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding BilibiliPartsHeader}"/>
                    </DockPanel>
                </Border>

                <!-- 搜索状态条：没有文案也不在加载时整条收起（否则就是一条空横带） -->
                <Border Grid.Row="2" Padding="12,5" Background="{DynamicResource AccentSoft}"
                        Visibility="{Binding IsStatusBarVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <!-- 搜索进行中：小转圈 + 状态文案 -->
                        <controls:LoadingSpinner Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,7,0"
                                                 Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding SearchStatus}" Foreground="{DynamicResource FgSecondary}" FontSize="12"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding SearchStatus, Converter={StaticResource StrNotEmptyToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- 搜索分类/歌手页的聚合内容：歌手卡 + 专辑卡（正方形圆角封面，与主页一致）。
                     卡片区不自己滚动：滚轮事件转给下方曲目列表（见 code-behind），
                     否则鼠标停在专辑卡上时滚不动，看不到下面的单曲列表。 -->
                <Border Grid.Row="3" Background="Transparent"
                        Visibility="{Binding IsSearchGroupPanelVisible, Converter={StaticResource BoolToVis}}"
                        PreviewMouseWheel="SearchGroupPanel_PreviewMouseWheel">
                    <StackPanel Margin="16,14,16,6">
                        <!-- ① 综合页签：歌手卡（取最匹配的一位） -->
                        <StackPanel Visibility="{Binding IsSearchMixedTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="歌手" Style="{StaticResource HomeSectionTitle}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding SearchTopArtists}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource HomeCardBtn}" Click="HomeCard_Click"
                                                Margin="0,0,0,10" HorizontalAlignment="Left"
                                                Command="{Binding Command}" CommandParameter="{Binding CommandParameter}"
                                                ToolTip="查看歌手页">
                                            <Border Background="{DynamicResource BgControl}" CornerRadius="10" Padding="12">
                                                <StackPanel Orientation="Horizontal">
                                                    <Grid Width="56" Height="56">
                                                        <Ellipse Fill="{DynamicResource BgDeeper}"/>
                                                        <TextBlock Text="🎤" FontSize="20" Foreground="{DynamicResource FgMuted}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Ellipse>
                                                            <Ellipse.Fill>
                                                                <ImageBrush Stretch="UniformToFill"
                                                                            ImageSource="{Binding CoverTrack.CoverKey, Converter={StaticResource PathToImageConv}, ConverterParameter=96}"/>
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                    </Grid>
                                                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="420">
                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource FgPrimary}"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgMuted}"
                                                                   FontSize="11" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ② 综合页签：专辑卡一行（列多一点，卡片小一点，给下方列表留空间） -->
                        <StackPanel Visibility="{Binding IsSearchMixedTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="专辑" Style="{StaticResource HomeSectionTitle}" Margin="0,6,0,10"/>
                            <ItemsControl ItemsSource="{Binding SearchAlbums}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource HomeCardBtn}" Margin="0,0,10,0"
                                                Click="HomeCard_Click"
                                                Command="{Binding Command}" CommandParameter="{Binding CommandParameter}"
                                                ToolTip="查看专辑">
                                            <StackPanel HorizontalAlignment="Left">
                                                <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                                                    <Grid Width="150" Height="150">
                                                        <Rectangle RadiusX="8" RadiusY="8" Fill="{DynamicResource BgControl}"/>
                                                        <TextBlock Text="💿" FontSize="26" Foreground="{DynamicResource FgMuted}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Rectangle RadiusX="8" RadiusY="8">
                                                            <Rectangle.Fill>
                                                                <ImageBrush Stretch="UniformToFill"
                                                                            ImageSource="{Binding CoverTrack.CoverKey, Converter={StaticResource PathToImageConv}, ConverterParameter=180}"/>
                                                            </Rectangle.Fill>
                                                        </Rectangle>
                                                    </Grid>
                                                </Viewbox>
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource FgNormal}"
                                                           FontSize="12" Margin="2,7,2,0" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgMuted}"
                                                           FontSize="10.5" Margin="2,2,2,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ③ 歌手页签：歌手卡片网格 -->
                        <StackPanel Visibility="{Binding IsSearchArtistsTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="歌手" Style="{StaticResource HomeSectionTitle}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding SearchArtists}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource HomeCardBtn}" Margin="0,0,10,0"
                                                Click="HomeCard_Click"
                                                Command="{Binding Command}" CommandParameter="{Binding CommandParameter}"
                                                ToolTip="查看歌手">
                                            <StackPanel HorizontalAlignment="Left">
                                                <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                                                    <Grid Width="150" Height="150">
                                                        <Ellipse Fill="{DynamicResource BgControl}"/>
                                                        <TextBlock Text="🎤" FontSize="30" Foreground="{DynamicResource FgMuted}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Ellipse>
                                                            <Ellipse.Fill>
                                                                <ImageBrush Stretch="UniformToFill"
                                                                            ImageSource="{Binding CoverTrack.CoverKey, Converter={StaticResource PathToImageConv}, ConverterParameter=180}"/>
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                    </Grid>
                                                </Viewbox>
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource FgNormal}"
                                                           FontSize="12" Margin="2,7,2,0" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgMuted}"
                                                           FontSize="10.5" Margin="2,2,2,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ④ 专辑页签：专辑卡片网格 -->
                        <StackPanel Visibility="{Binding IsSearchAlbumsTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="专辑" Style="{StaticResource HomeSectionTitle}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding SearchAlbums}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource HomeCardBtn}" Margin="0,0,10,0"
                                                Click="HomeCard_Click"
                                                Command="{Binding Command}" CommandParameter="{Binding CommandParameter}"
                                                ToolTip="查看专辑">
                                            <StackPanel HorizontalAlignment="Left">
                                                <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                                                    <Grid Width="150" Height="150">
                                                        <Rectangle RadiusX="8" RadiusY="8" Fill="{DynamicResource BgControl}"/>
                                                        <TextBlock Text="💿" FontSize="26" Foreground="{DynamicResource FgMuted}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Rectangle RadiusX="8" RadiusY="8">
                                                            <Rectangle.Fill>
                                                                <ImageBrush Stretch="UniformToFill"
                                                                            ImageSource="{Binding CoverTrack.CoverKey, Converter={StaticResource PathToImageConv}, ConverterParameter=180}"/>
                                                            </Rectangle.Fill>
                                                        </Rectangle>
                                                    </Grid>
                                                </Viewbox>
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource FgNormal}"
                                                           FontSize="12" Margin="2,7,2,0" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgMuted}"
                                                           FontSize="10.5" Margin="2,2,2,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ⑤ 歌手页「专辑」页签：该歌手的专辑卡片网格 -->
                        <StackPanel Visibility="{Binding IsArtistAlbumsTab, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="专辑" Style="{StaticResource HomeSectionTitle}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding ArtistAlbums}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource HomeCardBtn}" Margin="0,0,10,0"
                                                Click="HomeCard_Click"
                                                Command="{Binding Command}" CommandParameter="{Binding CommandParameter}"
                                                ToolTip="查看专辑">
                                            <StackPanel HorizontalAlignment="Left">
                                                <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                                                    <Grid Width="150" Height="150">
                                                        <Rectangle RadiusX="8" RadiusY="8" Fill="{DynamicResource BgControl}"/>
                                                        <TextBlock Text="💿" FontSize="26" Foreground="{DynamicResource FgMuted}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Rectangle RadiusX="8" RadiusY="8">
                                                            <Rectangle.Fill>
                                                                <ImageBrush Stretch="UniformToFill"
                                                                            ImageSource="{Binding CoverTrack.CoverKey, Converter={StaticResource PathToImageConv}, ConverterParameter=180}"/>
                                                            </Rectangle.Fill>
                                                        </Rectangle>
                                                    </Grid>
                                                </Viewbox>
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource FgNormal}"
                                                           FontSize="12" Margin="2,7,2,0" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgMuted}"
                                                           FontSize="10.5" Margin="2,2,2,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="4" x:Name="ContentArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListView x:Name="TrackList"
                          ItemsSource="{Binding CurrentTracks}"
                          Background="{DynamicResource BgMainAlpha}" BorderThickness="0"
                          ItemContainerStyle="{StaticResource TrackListStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsTrackListVisible, Converter={StaticResource BoolToVis}}"
                          MouseDoubleClick="TrackList_MouseDoubleClick"
                          ContextMenuOpening="TrackList_ContextMenuOpening">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="54" Header="">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- 固定 40x40 封面框：无封面时显示占位符，保证始终可点击进歌词。
                                         右边留 2px 余量 + 用 Rectangle 的 RadiusX/RadiusY 画封面：
                                         高 DPI（125%/150%）下像素舍入会让贴着单元格边缘的圆角"顶平"，
                                         留出余量后四角都能保住。 -->
                                    <Border Width="40" Height="40" Cursor="Hand" CornerRadius="4"
                                            Background="{DynamicResource BgControl}"
                                            UseLayoutRounding="True" SnapsToDevicePixels="True"
                                            Margin="0,0,2,0"
                                            MouseLeftButtonDown="CoverImage_Click"
                                            ToolTip="点击封面打开/关闭歌词">
                                        <Grid>
                                            <TextBlock Text="🎵" FontSize="18"
                                                       Foreground="{DynamicResource FgMuted}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Rectangle RadiusX="4" RadiusY="4"
                                                       Visibility="{Binding CoverKey, Converter={StaticResource StrNotEmptyToVis}}">
                                                <Rectangle.Fill>
                                                    <ImageBrush Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"
                                                                ImageSource="{Binding CoverKey, Converter={StaticResource PathToImageConv}, ConverterParameter=96}"/>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="250">
                            <GridViewColumn.Header>
                                <Button Content="标题" Tag="Title" Click="TrackHeaderButton_Click"
                                        Style="{StaticResource HeaderSortBtn}"
                                        ToolTip="点击切换：升序 → 降序 → 取消排序"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource FgNormal}" TextTrimming="CharacterEllipsis"/>
                                        <!-- 听歌排行视图的统计行：播放次数 + 累计时长 -->
                                        <TextBlock Text="{Binding ListenStatText}" Foreground="{DynamicResource FgMuted}"
                                                   FontSize="10.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding ListenStatText, Converter={StaticResource StrNotEmptyToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="150">
                            <GridViewColumn.Header>
                                <Button Content="艺术家" Tag="Artist" Click="TrackHeaderButton_Click"
                                        Style="{StaticResource HeaderSortBtn}"
                                        ToolTip="点击切换：升序 → 降序 → 取消排序"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- 点击歌手名 = 搜索该歌手 -->
                                    <TextBlock Text="{Binding Artist}" TextTrimming="CharacterEllipsis"
                                               Tag="Artist" Cursor="Hand"
                                               MouseLeftButtonDown="CellSearch_Click"
                                               ToolTip="点击搜索该歌手">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                        <Setter Property="TextDecorations" Value="Underline"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="185">
                            <GridViewColumn.Header>
                                <Button Content="专辑" Tag="Album" Click="TrackHeaderButton_Click"
                                        Style="{StaticResource HeaderSortBtn}"
                                        ToolTip="点击切换：升序 → 降序 → 取消排序"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- 点击专辑名 = 搜索该专辑；B 站曲目的这一列是来源标记，点击改为打开全集（分P） -->
                                    <TextBlock Text="{Binding Album}" TextTrimming="CharacterEllipsis"
                                               Tag="Album" Cursor="Hand"
                                               MouseLeftButtonDown="CellSearch_Click">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource FgSecondary}"/>
                                                <Setter Property="ToolTip" Value="点击搜索该专辑"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProviderId}" Value="bilibili">
                                                        <Setter Property="ToolTip" Value="点击查看全集（分P）"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                        <Setter Property="TextDecorations" Value="Underline"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="66">
                            <GridViewColumn.Header>
                                <Button Content="时长" Tag="Duration" Click="TrackHeaderButton_Click"
                                        Style="{StaticResource HeaderSortBtn}"
                                        ToolTip="点击切换：升序 → 降序 → 取消排序"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Duration, Converter={StaticResource TimeSpanToTextConv}}"
                                               Foreground="{DynamicResource FgSecondary}" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
                </ListView>

                <!-- 主页：把现有功能按卡片摆出来（横幅入口 / 我的歌单 / 快捷入口），不引入新功能 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Background="{DynamicResource BgMainAlpha}"
                              Visibility="{Binding IsHomeView, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="24,16,24,24">
                        <TextBlock Text="{Binding HomeSummary}" Foreground="{DynamicResource FgMuted}"
                                   FontSize="12" Margin="2,0,0,14"/>

                        <!-- ① 横幅：既有视图入口（封面取现有数据，缺封面时用内置设计图） -->
                        <ItemsControl ItemsSource="{Binding HomeBanners}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource HomeCardBtn}" Margin="0,0,10,0"
                                            Click="HomeCard_Click" ToolTip="{Binding Description}">
                                        <Border Height="116" CornerRadius="8" Background="{DynamicResource BgControl}">
                                            <Grid>
                                                <!-- 封面一律画在"圆角 Border 的背景"上：
                                                     WPF 的 ClipToBounds 不会按圆角裁剪子元素，
                                                     直接放 Image 会四角发方、UniformToFill 时还会溢出边框 -->
                                                <Border CornerRadius="8">
                                                    <Border.Background>
                                                        <ImageBrush Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"
                                                                    ImageSource="{Binding DefaultCover, Converter={StaticResource PathToImageConv}, ConverterParameter=240}"/>
                                                    </Border.Background>
                                                </Border>
                                                <Border CornerRadius="8"
                                                        Visibility="{Binding CoverTrack.CoverKey, Converter={StaticResource StrNotEmptyToVis}}">
                                                    <Border.Background>
                                                        <ImageBrush Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"
                                                                    ImageSource="{Binding CoverTrack.CoverKey, Converter={StaticResource PathToImageConv}, ConverterParameter=240}"/>
                                                    </Border.Background>
                                                </Border>
                                                <!-- 底部渐暗，保证文字可读又不压掉封面 -->
                                                <Border CornerRadius="8">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#33000000" Offset="0"/>
                                                            <GradientStop Color="#D9000000" Offset="0.75"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,9">
                                                    <TextBlock Text="{Binding Icon}" FontSize="15"/>
                                                    <TextBlock Text="{Binding Title}" Foreground="White"
                                                               FontWeight="Bold" FontSize="12.5" Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="#E6EDEFFB"
                                                               FontSize="10" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ② 我的歌单：用户歌单 + 新建占位卡（一行 6 格） -->
                        <DockPanel Margin="2,24,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="点歌单卡片即可打开" FontSize="11"
                                       Foreground="{DynamicResource FgMuted}" VerticalAlignment="Center"/>
                            <TextBlock Text="我的歌单" Style="{StaticResource HomeSectionTitle}"/>
                        </DockPanel>
                        <TextBlock Text="还没有歌单 —— 点「＋ 新建歌单」，或在列表里右键歌曲 →「添加到歌单」"
                                   Foreground="{DynamicResource FgMuted}" FontSize="11.5" Margin="2,0,0,10"
                                   Visibility="{Binding HasNoPlaylist, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding HomePlaylists}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource HomeCardBtn}" Margin="0,0,10,0"
                                            Click="HomeCard_Click" ToolTip="{Binding Title}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="🖼  设置自定义封面"
                                                          Command="{Binding Data.ChoosePlaylistCoverCommand, Source={StaticResource VmProxy}}"
                                                          CommandParameter="{Binding Playlist}"
                                                          Visibility="{Binding IsPlaceholder, Converter={StaticResource InvBoolToVis}}"/>
                                                <MenuItem Header="↺  恢复默认封面（最近添加的歌曲）"
                                                          Command="{Binding Data.ResetPlaylistCoverCommand, Source={StaticResource VmProxy}}"
                                                          CommandParameter="{Binding Playlist}"
                                                          Visibility="{Binding IsPlaceholder, Converter={StaticResource InvBoolToVis}}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel HorizontalAlignment="Left">
                                            <!-- Viewbox：封面始终是正方形、随列宽自适应，六张大小一致也不会溢出 -->
                                            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                                                <Grid Width="150" Height="150">
                                                    <!-- 占位底色 -->
                                                    <Border CornerRadius="8" Background="{DynamicResource BgControl}"/>
                                                    <TextBlock Text="🎵" FontSize="26" Foreground="{DynamicResource FgMuted}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <!-- 占位卡（新建歌单）：虚线框 + 大加号 -->
                                                    <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                            CornerRadius="8">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="＋" FontSize="30" HorizontalAlignment="Center"
                                                                       Foreground="{DynamicResource FgMuted}"/>
                                                            <TextBlock Text="新建歌单" FontSize="12" Margin="0,3,0,0"
                                                                       Foreground="{DynamicResource FgMuted}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- 默认封面 = 最近添加的那首歌；自定义封面优先 -->
                                                    <Border CornerRadius="8"
                                                            Visibility="{Binding Playlist.CoverPath, Converter={StaticResource StrNotEmptyToCollapsed}}">
                                                        <Border.Background>
                                                            <ImageBrush Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"
                                                                        ImageSource="{Binding Playlist.DefaultCoverTrack.CoverKey, Converter={StaticResource PathToImageConv}, ConverterParameter=180}"/>
                                                        </Border.Background>
                                                    </Border>
                                                    <Border CornerRadius="8"
                                                            Visibility="{Binding Playlist.CoverPath, Converter={StaticResource StrNotEmptyToVis}}">
                                                        <Border.Background>
                                                            <ImageBrush Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"
                                                                        ImageSource="{Binding Playlist.CoverPath, Converter={StaticResource PathToImageConv}, ConverterParameter=180}"/>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource FgNormal}"
                                                       FontSize="12" Margin="2,7,2,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgMuted}"
                                                       FontSize="10.5" Margin="2,2,2,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ③ 最近在听：最近播放过的曲目，点一下直接开播（用既有数据，不是新功能） -->
                        <DockPanel Margin="2,24,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="点封面即播（以最近播放为队列）" FontSize="11"
                                       Foreground="{DynamicResource FgMuted}" VerticalAlignment="Center"/>
                            <TextBlock Text="最近在听" Style="{StaticResource HomeSectionTitle}"/>
                        </DockPanel>
                        <TextBlock Text="还没有播放记录 —— 随便点首歌听听，这里会自动记录"
                                   Foreground="{DynamicResource FgMuted}" FontSize="11.5" Margin="2,0,0,10"
                                   Visibility="{Binding HasNoRecent, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding HomeRecentTracks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource HomeCardBtn}" Margin="0,0,10,0"
                                            Click="HomeCard_Click" ToolTip="{Binding Title}">
                                        <StackPanel HorizontalAlignment="Left">
                                            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                                                <Grid Width="150" Height="150">
                                                    <Border CornerRadius="8" Background="{DynamicResource BgControl}"/>
                                                    <TextBlock Text="🎵" FontSize="26" Foreground="{DynamicResource FgMuted}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Border CornerRadius="8">
                                                        <Border.Background>
                                                            <ImageBrush Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"
                                                                        ImageSource="{Binding CoverTrack.CoverKey, Converter={StaticResource PathToImageConv}, ConverterParameter=180}"/>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource FgNormal}"
                                                       FontSize="12" Margin="2,7,2,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource FgMuted}"
                                                       FontSize="10.5" Margin="2,2,2,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 空状态引导：列表为空时居中显示图标 + 引导文案（点击不遮挡列表交互） -->
                <Border Background="{DynamicResource BgMainAlpha}"
                        IsHitTestVisible="True"
                        Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24,0,24,40">
                        <!-- 搜索/扫描/缓冲等"在途"状态：显示转圈动画（其余情况显示耳机图标） -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,14">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusyWaiting}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <controls:LoadingSpinner Width="40" Height="40" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="🎧" FontSize="46" Opacity="0.3" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusyWaiting}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding EmptyStateText}"
                                   Foreground="{DynamicResource FgMuted}" FontSize="13.5"
                                   TextAlignment="Center" TextWrapping="Wrap" LineHeight="22"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                    <!-- 下载管理页（独立页面，与排行榜同级） -->
                    <Grid Visibility="{Binding IsDownloadView, Converter={StaticResource BoolToVis}}"
                          Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="16,10" Background="{DynamicResource BgPanel}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="📄 打开本地文件"
                                        Command="{Binding OpenLocalFilesCommand}"
                                        Style="{StaticResource BtnStyle}"
                                        ToolTip="选择一个或多个本地音频文件加入「本地歌曲」"/>
                                <TextBlock Text="{Binding DownloadTasks.Count, StringFormat={}{0} 个任务}"
                                           DockPanel.Dock="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="0,0,10,0"/>
                                <TextBlock Text="下载管理" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Text="右键歌曲选「下载到本地」加入队列，任务会自动逐个下载"
                                           Foreground="{DynamicResource FgMuted}" FontSize="12"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </DockPanel>
                        </Border>

                        <!-- 空状态：整块居中于内容区（图标与文字都水平居中） -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    MaxWidth="360" Margin="24,0,24,60">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DownloadTasks.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="📥" FontSize="42" Opacity="0.3" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="还没有下载任务" Foreground="{DynamicResource FgMuted}" FontSize="13.5"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="在列表里右键任意歌曲 → 下载到本地，即可在这里看到进度"
                                       Foreground="{DynamicResource FgMuted}" FontSize="11.5"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- 任务列表：每行显示标题/歌手、状态与操作 -->
                        <ListView Grid.Row="1" ItemsSource="{Binding DownloadTasks}" BorderThickness="0"
                                  Background="{DynamicResource BgMainAlpha}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="16,9"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock FontSize="13" Foreground="{DynamicResource FgNormal}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}">
                                                <Run Text="{Binding Title, Mode=OneWay}"/>
                                                <Run Text=" - " Foreground="{DynamicResource FgMuted}"/>
                                                <Run Text="{Binding Artist, Mode=OneWay}" Foreground="{DynamicResource FgMuted}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding StateText}" FontSize="11.5" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource FgMuted}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="重试" ToolTip="重新下载"
                                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding Data.RetryDownloadTaskCommand, Source={StaticResource VmProxy}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource QueueMiniBtn}"/>
                                            <Button Content="打开文件夹" ToolTip="打开下载所在目录"
                                                    Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding Data.OpenDownloadResultCommand, Source={StaticResource VmProxy}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource QueueMiniBtn}"/>
                                            <Button Content="✕" ToolTip="移除任务"
                                                    Visibility="{Binding IsQueuedOrRunning, Converter={StaticResource InvBoolToVis}}"
                                                    Command="{Binding Data.RemoveDownloadTaskCommand, Source={StaticResource VmProxy}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource QueueMiniBtn}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <!-- 搜索分页：结果超过一批时显示“加载更多”（网易云/QQ音乐/B站）。
                     放在列表下方的独立一行，避免浮在曲目行上面。 -->
                <Border Grid.Row="1" Padding="0,8,0,10"
                        Background="{DynamicResource BgMainAlpha}"
                        Visibility="{Binding IsSearchMoreVisible, Converter={StaticResource BoolToVis}}">
                    <Button Command="{Binding LoadMoreSearchResultsCommand}"
                            Content="{Binding SearchMoreText}"
                            Style="{StaticResource BtnStyle}" Padding="30,7" Cursor="Hand"
                            HorizontalAlignment="Center"
                            ToolTip="继续加载更多搜索结果"/>
                </Border>

            </Grid>

            <!-- 设置覆盖层：独立于内容区（内容区已隐藏），蒙层后只有背景图 -->
            <pages:SettingsPage Grid.Column="1" x:Name="SettingsPageHost" DataContext="{Binding Settings}"
                                Visibility="{Binding DataContext.IsShowingSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

            <!-- 歌词页覆盖层（默认隐藏，点击左下封面/列表封面切换）
                 整块盖住内容区（含侧边栏，ColumnSpan=2），只留顶部标题栏与下方播放条，
                 和"播放器模式"一致；布局：左侧黑胶唱片（播放时缓缓旋转）+ 右侧曲目信息与歌词 -->
            <Border Grid.Column="0" Grid.ColumnSpan="2" x:Name="LyricsOverlay"
                    Background="{DynamicResource BgMainAlpha}"
                    Visibility="{Binding IsLyricsOpen, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <!-- 顶部：收起 + 来源 + 既有工具（搜索歌词/字号/颜色/翻译/关闭） -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}" Padding="12,8"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Command="{Binding ToggleLyricsCommand}"
                                    Style="{StaticResource PlayerBtn}" Height="28" Padding="10,0"
                                    ToolTip="收起歌词页">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="收起" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding PlaybackBar.CurrentSourceText, StringFormat=来源：{0}}"
                                       Foreground="{DynamicResource FgMuted}" FontSize="12"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Background="{DynamicResource BgControl}" CornerRadius="12" Padding="8,2" Margin="0,0,8,0">
                                    <DockPanel Width="140">
                                        <TextBlock DockPanel.Dock="Right" Text="🔍" Foreground="{DynamicResource FgMuted}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        <Grid>
                                            <!-- 占位提示：文本为空时显示 -->
                                            <TextBlock Text="搜索歌词" Foreground="{DynamicResource FgMuted}"
                                                       FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Lyrics.SearchText}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Text="{Binding Lyrics.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{DynamicResource FgPrimary}" FontSize="11"
                                                     VerticalContentAlignment="Center"
                                                     ToolTip="输入歌名搜索歌词（如 Ref:rain - Aimer），回车匹配"
                                                     KeyDown="LyricSearch_KeyDown"/>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                                <Button Command="{Binding Lyrics.ToggleFontSizeCommand}"
                                        Style="{StaticResource PlayerBtn}" Width="32" Height="32"
                                        FontSize="13" FontWeight="Bold" ToolTip="切换歌词字号" Content="T"/>
                                <Button Command="{Binding Lyrics.CycleColorCommand}"
                                        Style="{StaticResource PlayerBtn}" Width="32" Height="32" Margin="6,0,0,0"
                                        ToolTip="切换歌词颜色">
                                    <TextBlock Text="🎨" FontSize="14"/>
                                </Button>
                                <Button Command="{Binding Lyrics.ToggleTranslationCommand}"
                                        Style="{StaticResource PlayerBtn}" Width="32" Height="32" Margin="6,0,0,0"
                                        FontSize="13" FontWeight="Bold" ToolTip="翻译歌词（中译文）" Content="译"
                                        Foreground="{Binding Lyrics.IsTranslated, Converter={StaticResource BoolToAccent}}"/>
                                <Button Content="✕" Command="{Binding ToggleLyricsCommand}"
                                        Style="{StaticResource PlayerBtn}" Width="32" Height="32" Margin="6,0,0,0"
                                        ToolTip="关闭歌词"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- 主体：左唱片 + 右信息/歌词 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" MinWidth="260"/>
                            <ColumnDefinition Width="1*" MinWidth="320"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左：黑胶唱片（封面作中心标签；播放时旋转）。放进 Viewbox，缩放时比例不变 -->
                        <Grid Grid.Column="0" Margin="24,16,8,16">
                            <Viewbox Width="336" Height="336" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Width="300" Height="300">
                                <!-- 唱臂：静态，压住唱片右上 -->
                                <Grid Width="300" Height="300" IsHitTestVisible="False">
                                    <Ellipse Width="30" Height="30" Fill="{DynamicResource BgControl}"
                                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,2,0,0"/>
                                    <Border Width="120" Height="7" CornerRadius="4" Background="#E8EDEFFB"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,24,0,0"
                                            RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="34"/>
                                        </Border.RenderTransform>
                                    </Border>
                                    <Ellipse Width="16" Height="16" Fill="#E8EDEFFB"
                                             HorizontalAlignment="Left" VerticalAlignment="Top" Margin="118,76,0,0"/>
                                </Grid>

                                <!-- 唱片本体（连同中心封面一起旋转；旋转由代码在播放/暂停时启停） -->
                                <Grid RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform x:Name="DiscRotate"/>
                                    </Grid.RenderTransform>

                                    <!-- 盘体（径向渐变：中心稍亮，边缘深黑） -->
                                    <Ellipse Width="280" Height="280">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#333333" Offset="0"/>
                                                <GradientStop Color="#161616" Offset="0.45"/>
                                                <GradientStop Color="#0A0A0A" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <!-- 纹路 -->
                                    <Ellipse Width="252" Height="252" Stroke="#14FFFFFF" StrokeThickness="1"/>
                                    <Ellipse Width="216" Height="216" Stroke="#10FFFFFF" StrokeThickness="1"/>
                                    <Ellipse Width="180" Height="180" Stroke="#0CFFFFFF" StrokeThickness="1"/>
                                    <!-- 高光（很淡的一条斜向反光） -->
                                    <Ellipse Width="280" Height="280" IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.85,1">
                                                <GradientStop Color="#0EFFFFFF" Offset="0"/>
                                                <GradientStop Color="#00FFFFFF" Offset="0.45"/>
                                                <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                                                <GradientStop Color="#0AFFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <!-- 中心标签：专辑封面（无封面时是占位图） -->
                                    <Ellipse Width="150" Height="150">
                                        <Ellipse.Fill>
                                            <ImageBrush Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center">
                                                <ImageBrush.ImageSource>
                                                    <Binding Path="PlaybackBar.CoverPath"
                                                             Converter="{StaticResource PathToImageConv}"
                                                             ConverterParameter="512"/>
                                                </ImageBrush.ImageSource>
                                            </ImageBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <!-- 中心孔 -->
                                    <Ellipse Width="16" Height="16" Fill="{DynamicResource BgMain}"/>
                                </Grid>
                            </Grid>
                            </Viewbox>
                        </Grid>

                        <!-- 右：曲目信息 + 操作 + 歌词 -->
                        <DockPanel Grid.Column="1" Margin="8,20,28,16">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="{Binding PlaybackBar.CurrentTitle}" Foreground="{DynamicResource FgPrimary}"
                                           FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding PlaybackBar.CurrentTitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="专辑：" Foreground="{DynamicResource FgMuted}" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PlaybackBar.CurrentTrack.Album, FallbackValue=—}"
                                               Foreground="{DynamicResource FgSecondary}" FontSize="12" Cursor="Hand"
                                               MouseLeftButtonDown="LyricAlbum_Click" TextTrimming="CharacterEllipsis"
                                               MaxWidth="150" VerticalAlignment="Center"/>
                                    <TextBlock Text="  歌手：" Foreground="{DynamicResource FgMuted}" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PlaybackBar.CurrentArtist}" Foreground="{DynamicResource FgSecondary}"
                                               FontSize="12" Cursor="Hand" MouseLeftButtonDown="LyricArtist_Click"
                                               TextTrimming="CharacterEllipsis" MaxWidth="130" VerticalAlignment="Center"/>
                                    <TextBlock Text="  来源：" Foreground="{DynamicResource FgMuted}" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PlaybackBar.CurrentSourceText}"
                                               Foreground="{DynamicResource FgSecondary}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" MaxWidth="110" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- 操作：都是既有能力（收藏/下载/桌面歌词/翻译） -->
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Style="{StaticResource LyricChip}" Command="{Binding ToggleCurrentFavoriteCommand}"
                                            ToolTip="收藏 / 取消收藏当前歌曲">
                                        <TextBlock Text="❤ 收藏" FontSize="11.5"
                                                   Foreground="{Binding IsCurrentFavorited, Converter={StaticResource BoolToAccent}}"/>
                                    </Button>
                                    <Button Style="{StaticResource LyricChip}" Margin="8,0,0,0"
                                            Command="{Binding DownloadTrackCommand}"
                                            CommandParameter="{Binding PlaybackBar.CurrentTrack}"
                                            Content="⬇ 下载" ToolTip="把当前歌曲下载到本地"/>
                                    <Button Style="{StaticResource LyricChip}" Margin="8,0,0,0"
                                            Command="{Binding ToggleDesktopLyricsCommand}"
                                            Content="🖥 桌面歌词" ToolTip="显示/隐藏独立的桌面歌词悬浮窗"/>
                                    <Button Style="{StaticResource LyricChip}" Margin="8,0,0,0"
                                            Command="{Binding Lyrics.ToggleTranslationCommand}"
                                            Content="译 翻译" ToolTip="显示/隐藏歌词翻译"/>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,16,0,14"/>
                            </StackPanel>
                            <controls:LyricView DataContext="{Binding Lyrics}"/>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
        </DockPanel>

        <!-- 卡片播放模式已改为独立悬浮小窗（Views/MiniPlayerWindow），由 🎛 按钮开关 -->
    </Grid>
</Window>
