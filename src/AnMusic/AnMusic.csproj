<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 版本号唯一来源：运行时通过程序集读取（见 SettingsViewModel.CurrentVersion） -->
    <Version>3.1.0</Version>
    <Product>AnMusic</Product>
    <AssemblyTitle>AnMusic</AssemblyTitle>
    <Company>PainterAnkry</Company>
    <Copyright>Copyright © 2026 PainterAnkry</Copyright>
    <!-- 保持与旧版一致的输出目录（bin\$(Configuration)\net10.0-windows\），避免 TFM 变更后路径漂移 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>bin\$(Configuration)\net10.0-windows\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- 插件宿主内置 JS 库（require('crypto-js') 等宿主模块） -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Plugins\crypto-js.min.js" />
    <EmbeddedResource Include="Assets\Plugins\dayjs.min.js" />
    <EmbeddedResource Include="Assets\Plugins\big-integer.min.js" />
    <EmbeddedResource Include="Assets\Plugins\jsencrypt.min.js" />
    <EmbeddedResource Include="Assets\Plugins\he.min.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Jint" Version="4.16.1" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.158" />
    <PackageReference Include="NAudio" Version="3.1.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

</Project>
