<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AnMusic.Models;assembly=AnMusic.Core"
             xmlns:vm="clr-namespace:AnMusic.Android.ViewModels"
             xmlns:conv="clr-namespace:AnMusic.Android.Converters"
             xmlns:svc="clr-namespace:AnMusic.Android.Services"
             x:Class="AnMusic.Android.MainPage"
             x:DataType="vm:LibraryViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource AmBg}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:HasValueConverter x:Key="HasValue" />
            <conv:InvertBoolConverter x:Key="InvertBool" />
            <conv:DurationConverter x:Key="Duration" />

            <!-- 快捷宫格图标底色 -->
            <Style x:Key="QuickTile" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{DynamicResource AmPrimarySoft}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="WidthRequest" Value="50" />
                <Setter Property="HeightRequest" Value="50" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <CollectionView Grid.Row="0"
                        x:Name="TrackList"
                        ItemsSource="{Binding VisibleTracks}"
                        SelectionMode="None">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="16" Padding="0,0,0,8">

                    <!-- ══ 顶栏：汉堡 + 问候 + 搜索 ══ -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          Style="{DynamicResource AmTopBar}"
                          Padding="6,10,12,0">
                        <Button Grid.Column="0"
                                Text="☰"
                                Style="{DynamicResource AmIconButton}"
                                FontSize="20"
                                Clicked="OnOpenFlyoutClicked" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding Greeting}"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   TextColor="{DynamicResource AmTextPrimary}" />
                            <Label Text="今天也要听喜欢的音乐"
                                   FontSize="12"
                                   TextColor="{DynamicResource AmTextTertiary}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2"
                                Text="🔍"
                                Style="{DynamicResource AmIconButton}"
                                Clicked="OnOpenSearchClicked" />
                    </Grid>

                    <!-- ══ 搜索胶囊（点击跳搜索页）══ -->
                    <Border Margin="16,0,16,0"
                            HeightRequest="44"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="{DynamicResource AmSurface}"
                            svc:PressFeedback.IsEnabled="True">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenSearchClicked" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="16,0">
                            <Label Grid.Column="0"
                                   Text="🔍"
                                   FontSize="14"
                                   TextColor="{DynamicResource AmTextTertiary}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="搜索歌曲、歌手、专辑"
                                   FontSize="14"
                                   TextColor="{DynamicResource AmTextTertiary}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- ══ 快捷功能宫格 ══ -->
                    <Grid ColumnDefinitions="*,*,*,*,*"
                          Padding="12,0,12,0"
                          ColumnSpacing="4">
                        <VerticalStackLayout Grid.Column="0" Spacing="6" HorizontalOptions="Center">
                            <Border Style="{StaticResource QuickTile}"
                                    svc:PressFeedback.IsEnabled="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickTapped" CommandParameter="All" />
                                </Border.GestureRecognizers>
                                <Label Text="♫" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="本地" FontSize="11" TextColor="{DynamicResource AmTextSecondary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center">
                            <Border Style="{StaticResource QuickTile}"
                                    svc:PressFeedback.IsEnabled="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickTapped" CommandParameter="Favorites" />
                                </Border.GestureRecognizers>
                                <Label Text="♥" FontSize="20" TextColor="{DynamicResource AmPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="我喜欢" FontSize="11" TextColor="{DynamicResource AmTextSecondary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="Center">
                            <Border Style="{StaticResource QuickTile}"
                                    svc:PressFeedback.IsEnabled="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickTapped" CommandParameter="Recent" />
                                </Border.GestureRecognizers>
                                <Label Text="🕒" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="最近" FontSize="11" TextColor="{DynamicResource AmTextSecondary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="3" Spacing="6" HorizontalOptions="Center">
                            <Border Style="{StaticResource QuickTile}"
                                    svc:PressFeedback.IsEnabled="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickTapped" CommandParameter="Recommend" />
                                </Border.GestureRecognizers>
                                <Label Text="✨" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="每日推荐" FontSize="11" TextColor="{DynamicResource AmTextSecondary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="4" Spacing="6" HorizontalOptions="Center">
                            <Border Style="{StaticResource QuickTile}"
                                    svc:PressFeedback.IsEnabled="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDownloadsTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="⬇" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="下载" FontSize="11" TextColor="{DynamicResource AmTextSecondary}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- ══ 推荐横幅 ══ -->
                    <Border Margin="16,0,16,0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            Padding="18,16"
                            svc:PressFeedback.IsEnabled="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{DynamicResource AmPrimary}" Offset="0" />
                                <GradientStop Color="{DynamicResource AmPrimaryDark}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnQuickTapped" CommandParameter="Recommend" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                <Label Text="每日推荐"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="#FFFFFF" />
                                <Label Text="根据本地曲库为你随机挑选 30 首"
                                       FontSize="12"
                                       TextColor="#CCFFFFFF" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="🎲" FontSize="30" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- ══ 分段 Tab ══ -->
                    <Border Style="{DynamicResource AmSegmentedBar}"
                            Margin="16,0,16,0">
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                            <Button x:Name="TabAll"
                                    Grid.Column="0"
                                    Text="本地"
                                    Style="{DynamicResource AmSegmentedButton}"
                                    Clicked="OnTabClicked" CommandParameter="All" />
                            <Button x:Name="TabFavorites"
                                    Grid.Column="1"
                                    Text="喜欢"
                                    Style="{DynamicResource AmSegmentedButton}"
                                    Clicked="OnTabClicked" CommandParameter="Favorites" />
                            <Button x:Name="TabRecent"
                                    Grid.Column="2"
                                    Text="最近"
                                    Style="{DynamicResource AmSegmentedButton}"
                                    Clicked="OnTabClicked" CommandParameter="Recent" />
                            <Button x:Name="TabRecommend"
                                    Grid.Column="3"
                                    Text="推荐"
                                    Style="{DynamicResource AmSegmentedButton}"
                                    Clicked="OnTabClicked" CommandParameter="Recommend" />
                        </Grid>
                    </Border>

                    <!-- ══ 操作行 ══ -->
                    <Grid Padding="16,0,16,6"
                          ColumnDefinitions="Auto,Auto,Auto,Auto,*"
                          ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="▶ 播放全部"
                                Command="{Binding PlayAllCommand}"
                                Style="{DynamicResource AmGhostButton}"
                                HeightRequest="34"
                                FontSize="13"
                                Padding="16,0">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding VisibleTracks.Count}"
                                             Value="0">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button Grid.Column="1"
                                Text="随机"
                                Command="{Binding ShuffleAllCommand}"
                                Style="{DynamicResource AmGhostButton}"
                                HeightRequest="34"
                                FontSize="13"
                                Padding="16,0" />

                        <Button Grid.Column="2"
                                Text="扫描"
                                Command="{Binding ScanCommand}"
                                Style="{DynamicResource AmGhostButton}"
                                HeightRequest="34"
                                FontSize="13"
                                Padding="16,0" />

                        <Button Grid.Column="3"
                                Text="{Binding SortLabel}"
                                Command="{Binding ChangeSortCommand}"
                                Style="{DynamicResource AmGhostButton}"
                                HeightRequest="34"
                                FontSize="13"
                                Padding="14,0" />

                        <Label Grid.Column="4"
                               Text="{Binding ScanStatus}"
                               Style="{DynamicResource AmCaptionText}"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="End"
                               LineBreakMode="TailTruncation" />
                    </Grid>

                    <!-- ══ 区块标题 ══ -->
                    <Grid Padding="16,0,16,8" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="{Binding HeaderText}"
                               Style="{DynamicResource AmSectionTitle}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding CountText}"
                               Style="{DynamicResource AmCaptionText}"
                               VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Track">
                    <Grid RowDefinitions="Auto,Auto" BackgroundColor="{DynamicResource AmBg}">

                        <Grid Grid.Row="0"
                              Padding="16,10"
                              ColumnDefinitions="Auto,*,Auto,Auto"
                              ColumnSpacing="12"
                              svc:PressFeedback.IsEnabled="True"
                              svc:PressFeedback.Scale="0.985">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTrackTapped" />
                            </Grid.GestureRecognizers>

                            <!-- 封面缩略图 -->
                            <Border Grid.Column="0"
                                    Style="{DynamicResource AmCoverSmall}"
                                    VerticalOptions="Center">
                                <Grid>
                                    <Label Text="♪"
                                           FontSize="20"
                                           TextColor="{DynamicResource AmTextOnPrimary}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding CoverKey, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                    <Image Source="{Binding CoverKey}"
                                           Aspect="AspectFill"
                                           IsVisible="{Binding CoverKey, Converter={StaticResource HasValue}}" />
                                </Grid>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding Title}" Style="{DynamicResource AmTitleText}" />
                                <Label Text="{Binding Artist}" Style="{DynamicResource AmSubText}" />
                            </VerticalStackLayout>

                            <Label Grid.Column="2"
                                   Text="{Binding Duration, Converter={StaticResource Duration}}"
                                   Style="{DynamicResource AmCaptionText}"
                                   VerticalOptions="Center" />

                            <Button Grid.Column="3"
                                    Text="⋯"
                                    Style="{DynamicResource AmRowMenuButton}"
                                    Clicked="OnTrackMenuClicked" />
                        </Grid>

                        <BoxView Grid.Row="1"
                                 Style="{DynamicResource AmDividerLine}"
                                 Margin="76,0,16,0" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40,40" Spacing="12">
                    <Label Text="🎵"
                           FontSize="46"
                           HorizontalOptions="Center" />
                    <Label Text="这里还没有音乐"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource AmTextPrimary}"
                           HorizontalOptions="Center" />
                    <Label Text="点击「扫描」，导入设备中的音频文件"
                           FontSize="13"
                           TextColor="{DynamicResource AmTextTertiary}"
                           HorizontalTextAlignment="Center" />
                    <Button Text="扫描本地音乐"
                            Command="{Binding ScanCommand}"
                            Style="{DynamicResource AmPrimaryButton}"
                            HorizontalOptions="Center"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- 扫描中浮层 -->
        <Border Grid.Row="0"
                IsVisible="{Binding IsScanning}"
                BackgroundColor="{DynamicResource AmOverlay}"
                StrokeThickness="0">
            <Border StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="{DynamicResource AmSurface}"
                    WidthRequest="130"
                    HeightRequest="130"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="12">
                    <ActivityIndicator IsRunning="{Binding IsScanning}"
                                       WidthRequest="38"
                                       HeightRequest="38" />
                    <Label Text="正在扫描…"
                           Style="{DynamicResource AmCaptionText}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Border>

        <!-- ══════════ 底部迷你播放条 ══════════ -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto" x:Name="MiniBar">

            <ProgressBar Grid.Row="0"
                         Progress="{Binding Player.ProgressFraction}"
                         HeightRequest="2"
                         ProgressColor="{DynamicResource AmPrimary}"
                         BackgroundColor="{DynamicResource AmDivider}" />

            <Border Grid.Row="1" Style="{DynamicResource AmMiniBar}">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">

                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMiniPlayerTapped" />
                        </Grid.GestureRecognizers>

                        <Border Grid.Column="0"
                                Style="{DynamicResource AmCoverSmall}"
                                VerticalOptions="Center">
                            <Grid>
                                <Label Text="♪"
                                       FontSize="20"
                                       TextColor="{DynamicResource AmTextOnPrimary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding Player.CoverPath, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                <Image Source="{Binding Player.CoverPath}"
                                       Aspect="AspectFill"
                                       IsVisible="{Binding Player.CoverPath, Converter={StaticResource HasValue}}" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Player.Title}"
                                   Style="{DynamicResource AmTitleText}"
                                   FontSize="14" />
                            <Label Text="{Binding Player.Artist}"
                                   Style="{DynamicResource AmSubText}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Button Grid.Column="1"
                            Text="{Binding Player.PlayPauseIcon}"
                            Command="{Binding Player.PlayPauseCommand}"
                            IsEnabled="{Binding Player.HasTrack}"
                            Style="{DynamicResource AmIconButton}"
                            FontSize="24"
                            VerticalOptions="Center" />

                    <Button Grid.Column="2"
                            Text="⏭"
                            Command="{Binding Player.NextCommand}"
                            IsEnabled="{Binding Player.HasTrack}"
                            Style="{DynamicResource AmIconButton}"
                            FontSize="22"
                            VerticalOptions="Center" />

                    <Button Grid.Column="3"
                            Text="☰"
                            IsEnabled="{Binding Player.HasTrack}"
                            Style="{DynamicResource AmIconButton}"
                            FontSize="19"
                            VerticalOptions="Center"
                            Clicked="OnOpenQueueClicked" />
                </Grid>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
