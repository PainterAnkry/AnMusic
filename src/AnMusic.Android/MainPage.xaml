<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AnMusic.Models;assembly=AnMusic.Core"
             xmlns:vm="clr-namespace:AnMusic.Android.ViewModels"
             xmlns:conv="clr-namespace:AnMusic.Android.Converters"
             x:Class="AnMusic.Android.MainPage"
             x:DataType="vm:LibraryViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource AmBg}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:HasValueConverter x:Key="HasValue" />
            <conv:InvertBoolConverter x:Key="InvertBool" />
            <conv:EqualsConverter x:Key="Equals" />
            <conv:DurationConverter x:Key="Duration" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ══════════ 顶部栏：侧边栏 / 标题 / 搜索 ══════════ -->
        <Grid Grid.Row="0"
              Style="{DynamicResource AmTopBar}"
              ColumnDefinitions="Auto,*,Auto">

            <Button Grid.Column="0"
                    Text="☰"
                    Style="{DynamicResource AmIconButton}"
                    FontSize="20"
                    Clicked="OnOpenFlyoutClicked" />

            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label Text="{Binding HeaderText}"
                       Style="{DynamicResource AmPageTitle}"
                       FontSize="19" />
                <Label Text="{Binding CountText}"
                       Style="{DynamicResource AmCaptionText}" />
            </VerticalStackLayout>

            <Button Grid.Column="2"
                    Text="🔍"
                    Style="{DynamicResource AmIconButton}"
                    Clicked="OnOpenSearchClicked" />
        </Grid>

        <!-- ══════════ 分段控件 ══════════ -->
        <Border Grid.Row="1"
                Style="{DynamicResource AmSegmentedBar}"
                Margin="16,2,16,10">
            <Grid ColumnDefinitions="*,*,*,*">
                <Button x:Name="TabAllBtn"
                        Grid.Column="0"
                        Text="本地音乐"
                        Style="{DynamicResource AmSegmentedButton}"
                        Clicked="OnTabAllClicked" />
                <Button x:Name="TabFavBtn"
                        Grid.Column="1"
                        Text="我喜欢"
                        Style="{DynamicResource AmSegmentedButton}"
                        Clicked="OnTabFavoritesClicked" />
                <Button x:Name="TabPlBtn"
                        Grid.Column="2"
                        Text="歌单"
                        Style="{DynamicResource AmSegmentedButton}"
                        Clicked="OnTabPlaylistsClicked" />
                <Button x:Name="TabRecentBtn"
                        Grid.Column="3"
                        Text="最近播放"
                        Style="{DynamicResource AmSegmentedButton}"
                        Clicked="OnTabRecentClicked" />
            </Grid>
        </Border>

        <!-- ══════════ 曲库内容 ══════════ -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*">

            <!-- 歌单横向选择条（仅「歌单」标签可见） -->
            <ScrollView Grid.Row="0"
                        x:Name="PlaylistStrip"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        IsVisible="False"
                        Padding="16,0,16,10">
                <HorizontalStackLayout Spacing="8">
                    <Button Text="＋ 新建歌单"
                            Style="{DynamicResource AmOutlineButton}"
                            HeightRequest="34"
                            Clicked="OnCreatePlaylistClicked" />

                    <HorizontalStackLayout x:Name="PlaylistChips"
                                           BindableLayout.ItemsSource="{Binding Playlists}"
                                           Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Playlist">
                                <Border Style="{DynamicResource AmChip}"
                                        HeightRequest="34"
                                        Padding="14,0"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPlaylistChipTapped" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Name}"
                                           Style="{DynamicResource AmChipText}"
                                           VerticalOptions="Center" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
            </ScrollView>

            <CollectionView Grid.Row="1"
                            x:Name="TrackList"
                            ItemsSource="{Binding VisibleTracks}"
                            SelectionMode="None">

                <!-- 列表头：播放全部 / 随机 / 扫描 / 排序 -->
                <CollectionView.Header>
                    <Grid Padding="16,0,16,10"
                          ColumnDefinitions="Auto,Auto,Auto,Auto,*"
                          ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="▶  播放全部"
                                Command="{Binding PlayAllCommand}"
                                Style="{DynamicResource AmGhostButton}"
                                HeightRequest="34"
                                FontSize="13"
                                Padding="16,0">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button"
                                             Binding="{Binding VisibleTracks.Count}"
                                             Value="0">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button Grid.Column="1"
                                Text="随机"
                                Command="{Binding ShuffleAllCommand}"
                                Style="{DynamicResource AmGhostButton}"
                                HeightRequest="34"
                                FontSize="13"
                                Padding="16,0" />

                        <Button Grid.Column="2"
                                Text="扫描"
                                Command="{Binding ScanCommand}"
                                Style="{DynamicResource AmGhostButton}"
                                HeightRequest="34"
                                FontSize="13"
                                Padding="16,0"
                                IsVisible="{Binding CurrentTab, Converter={StaticResource Equals}, ConverterParameter=All}" />

                        <Button x:Name="SortBtn"
                                Grid.Column="3"
                                Text="{Binding SortLabel}"
                                Command="{Binding ChangeSortCommand}"
                                Style="{DynamicResource AmGhostButton}"
                                HeightRequest="34"
                                FontSize="13"
                                Padding="14,0" />

                        <Label Grid.Column="4"
                               Text="{Binding ScanStatus}"
                               Style="{DynamicResource AmCaptionText}"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="End"
                               LineBreakMode="TailTruncation" />
                    </Grid>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Grid RowDefinitions="Auto,Auto" BackgroundColor="{DynamicResource AmSurface}">

                            <Grid Grid.Row="0"
                                  Padding="16,10"
                                  ColumnDefinitions="Auto,*,Auto,Auto"
                                  ColumnSpacing="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTrackTapped" />
                                </Grid.GestureRecognizers>

                                <!-- 封面缩略图（无图时显示音符占位） -->
                                <Border Grid.Column="0"
                                        Style="{DynamicResource AmCoverSmall}"
                                        VerticalOptions="Center">
                                    <Grid>
                                        <Label Text="♪"
                                               FontSize="20"
                                               TextColor="{DynamicResource AmTextOnPrimary}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding CoverKey, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                        <Image Source="{Binding CoverKey}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding CoverKey, Converter={StaticResource HasValue}}" />
                                    </Grid>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" Style="{DynamicResource AmTitleText}" />
                                    <Label Text="{Binding Artist}" Style="{DynamicResource AmSubText}" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="{Binding Duration, Converter={StaticResource Duration}}"
                                       Style="{DynamicResource AmCaptionText}"
                                       VerticalOptions="Center" />

                                <Button Grid.Column="3"
                                        Text="⋯"
                                        Style="{DynamicResource AmRowMenuButton}"
                                        Clicked="OnTrackMenuClicked" />
                            </Grid>

                            <BoxView Grid.Row="1"
                                     Style="{DynamicResource AmDividerLine}"
                                     Margin="76,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- 空状态 -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40,56" Spacing="12" IsVisible="{Binding IsEmpty}">
                        <Label Text="🎵"
                               FontSize="46"
                               HorizontalOptions="Center" />
                        <Label Text="这里还没有音乐"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource AmTextPrimary}"
                               HorizontalOptions="Center" />
                        <Label Text="点击上方「扫描」，导入设备中的音频文件"
                               FontSize="13"
                               TextColor="{DynamicResource AmTextTertiary}"
                               HorizontalTextAlignment="Center" />
                        <Button Text="扫描本地音乐"
                                Command="{Binding ScanCommand}"
                                Style="{DynamicResource AmPrimaryButton}"
                                HorizontalOptions="Center"
                                Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- 扫描中遮罩 -->
            <VerticalStackLayout IsVisible="{Binding IsScanning}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsScanning}"
                                   WidthRequest="38"
                                   HeightRequest="38" />
                <Label Text="正在扫描…" Style="{DynamicResource AmCaptionText}" />
            </VerticalStackLayout>
        </Grid>

        <!-- ══════════ 底部迷你播放条 ══════════ -->
        <Grid Grid.Row="3" RowDefinitions="Auto,Auto">

            <ProgressBar Grid.Row="0"
                         Progress="{Binding Player.ProgressFraction}"
                         HeightRequest="2"
                         ProgressColor="{DynamicResource AmPrimary}"
                         BackgroundColor="{DynamicResource AmDivider}" />

            <Border Grid.Row="1" Style="{DynamicResource AmMiniBar}">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">

                    <!-- 左半区：封面 + 歌曲信息，整块可点开播放详情 -->
                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMiniPlayerTapped" />
                        </Grid.GestureRecognizers>

                        <Border Grid.Column="0"
                                Style="{DynamicResource AmCoverSmall}"
                                VerticalOptions="Center">
                            <Grid>
                                <Label Text="♪"
                                       FontSize="20"
                                       TextColor="{DynamicResource AmTextOnPrimary}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding Player.CoverPath, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                <Image Source="{Binding Player.CoverPath}"
                                       Aspect="AspectFill"
                                       IsVisible="{Binding Player.CoverPath, Converter={StaticResource HasValue}}" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Player.Title}"
                                   Style="{DynamicResource AmTitleText}"
                                   FontSize="14" />
                            <Label Text="{Binding Player.Artist}"
                                   Style="{DynamicResource AmSubText}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Button Grid.Column="1"
                            Text="{Binding Player.PlayPauseIcon}"
                            Command="{Binding Player.PlayPauseCommand}"
                            IsEnabled="{Binding Player.HasTrack}"
                            Style="{DynamicResource AmIconButton}"
                            FontSize="24"
                            VerticalOptions="Center" />

                    <Button Grid.Column="2"
                            Text="⏭"
                            Command="{Binding Player.NextCommand}"
                            IsEnabled="{Binding Player.HasTrack}"
                            Style="{DynamicResource AmIconButton}"
                            FontSize="22"
                            VerticalOptions="Center" />

                    <Button Grid.Column="3"
                            Text="☰"
                            IsEnabled="{Binding Player.HasTrack}"
                            Style="{DynamicResource AmIconButton}"
                            FontSize="19"
                            VerticalOptions="Center"
                            Clicked="OnOpenQueueClicked" />
                </Grid>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
