<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AnMusic.Models;assembly=AnMusic.Core"
             xmlns:vm="clr-namespace:AnMusic.Android.ViewModels"
             xmlns:conv="clr-namespace:AnMusic.Android.Converters"
             xmlns:svc="clr-namespace:AnMusic.Android.Services"
             x:Class="AnMusic.Android.SearchPage"
             x:DataType="vm:SearchViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource AmBg}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:HasValueConverter x:Key="HasValue" />
            <conv:InvertBoolConverter x:Key="InvertBool" />
            <conv:DurationConverter x:Key="Duration" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ══ 顶栏：返回 + 搜索输入 + 搜索按钮 ══ -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto,Auto"
              ColumnSpacing="6"
              Padding="6,8,12,4">

            <Button Grid.Column="0"
                    Text="‹"
                    Style="{DynamicResource AmIconButton}"
                    FontSize="26"
                    Clicked="OnBackClicked" />

            <Border Grid.Column="1" Style="{DynamicResource AmSearchField}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="🔍"
                           FontSize="14"
                           TextColor="{DynamicResource AmTextTertiary}"
                           VerticalOptions="Center" />
                    <Entry Grid.Column="1"
                           x:Name="SearchEntry"
                           Placeholder="搜索歌曲、歌手、专辑"
                           ReturnType="Search"
                           Text="{Binding Keyword}"
                           Style="{DynamicResource AmSearchEntry}"
                           Completed="OnSearchCompleted" />
                    <Button Grid.Column="2"
                            Text="✕"
                            FontSize="14"
                            TextColor="{DynamicResource AmTextTertiary}"
                            BackgroundColor="Transparent"
                            Padding="0"
                            WidthRequest="30"
                            HeightRequest="44"
                            MinimumHeightRequest="0"
                            Clicked="OnClearKeywordClicked" />
                </Grid>
            </Border>

            <Button Grid.Column="2"
                    Text="☰"
                    Style="{DynamicResource AmIconButton}"
                    FontSize="20"
                    Clicked="OnOpenFlyoutClicked" />

            <Button Grid.Column="3"
                    Text="搜索"
                    Style="{DynamicResource AmTextButton}"
                    WidthRequest="46"
                    Command="{Binding SearchCommand}" />
        </Grid>

        <!-- ══ 音源选择：去掉本地，只显示已安装的在线插件源 ══ -->
        <VerticalStackLayout Grid.Row="1" Spacing="6">
            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Padding="16,2,16,4">
                <HorizontalStackLayout x:Name="SourceChips"
                                       BindableLayout.ItemsSource="{Binding Sources}"
                                       Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchSource">
                            <Border HeightRequest="34"
                                    Padding="14,0"
                                    VerticalOptions="Center"
                                    svc:PressFeedback.IsEnabled="True"
                                    BackgroundColor="{DynamicResource AmSurface}"
                                    Stroke="{DynamicResource AmDivider}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 17">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding IsSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource AmPrimary}" />
                                        <Setter Property="Stroke" Value="{DynamicResource AmPrimary}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSourceChipTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding Label}"
                                       VerticalOptions="Center"
                                       TextColor="{DynamicResource AmTextPrimary}"
                                       FontSize="13">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsSelected}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource AmTextOnPrimary}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Label Text="{Binding StatusText}"
                   Style="{DynamicResource AmCaptionText}"
                   Margin="16,0"
                   LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <!-- ══ 结果区 ══ -->
        <Grid Grid.Row="2">

            <!-- 结果列表 -->
            <CollectionView x:Name="ResultList"
                            ItemsSource="{Binding Results}"
                            SelectionMode="None"
                            IsVisible="{Binding ShowEmpty, Converter={StaticResource InvertBool}}">

                <CollectionView.Header>
                    <Grid Padding="16,4,16,10" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="{Binding ResultCountText}"
                               Style="{DynamicResource AmCaptionText}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="▶ 播放全部"
                                Command="{Binding PlayAllResultsCommand}"
                                Style="{DynamicResource AmOutlineButton}"
                                HeightRequest="32"
                                FontSize="12" />
                    </Grid>
                </CollectionView.Header>

                <!-- 加载更多：只有支持分页的插件源才显示 -->
                <CollectionView.Footer>
                    <Button Text="{Binding LoadMoreText}"
                            Command="{Binding LoadMoreCommand}"
                            IsVisible="{Binding HasMore}"
                            Style="{DynamicResource AmOutlineButton}"
                            Margin="0,10,0,16"
                            HorizontalOptions="Center" />
                </CollectionView.Footer>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Track">
                        <Grid RowDefinitions="Auto,Auto" BackgroundColor="{DynamicResource AmBg}">

                            <Grid Grid.Row="0"
                                  Padding="16,10"
                                  ColumnDefinitions="Auto,*,Auto,Auto"
                                  ColumnSpacing="12"
                                  svc:PressFeedback.IsEnabled="True"
                                  svc:PressFeedback.Scale="0.985">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnResultTapped" />
                                </Grid.GestureRecognizers>

                                <Border Grid.Column="0"
                                        Style="{DynamicResource AmCoverSmall}"
                                        VerticalOptions="Center">
                                    <Grid>
                                        <Label Text="♪"
                                               FontSize="20"
                                               TextColor="{DynamicResource AmTextOnPrimary}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding CoverKey, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                        <Image Source="{Binding CoverKey}"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding CoverKey, Converter={StaticResource HasValue}}" />
                                    </Grid>
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" Style="{DynamicResource AmTitleText}" />
                                    <Label Text="{Binding Artist}" Style="{DynamicResource AmSubText}" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="{Binding Duration, Converter={StaticResource Duration}}"
                                       Style="{DynamicResource AmCaptionText}"
                                       VerticalOptions="Center" />

                                <Button Grid.Column="3"
                                        Text="⋯"
                                        Style="{DynamicResource AmRowMenuButton}"
                                        Clicked="OnResultMenuClicked" />
                            </Grid>

                            <BoxView Grid.Row="1" Style="{DynamicResource AmDividerLine}" Margin="76,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- 空结果 -->
            <VerticalStackLayout IsVisible="{Binding ShowEmpty}"
                                 Padding="40"
                                 Spacing="10"
                                 VerticalOptions="Center">
                <Label Text="🔍" FontSize="42" HorizontalOptions="Center" />
                <Label Text="没有找到相关歌曲"
                       FontSize="15"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <Label Text="换个关键词，或切换其它音源试试"
                       Style="{DynamicResource AmCaptionText}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- 初始态：搜索历史 -->
            <VerticalStackLayout IsVisible="{Binding HasSearched, Converter={StaticResource InvertBool}}"
                                 Padding="16,8"
                                 Spacing="12">

                <Label x:Name="HistoryTitle"
                       Text="搜索历史"
                       Style="{DynamicResource AmSectionTitle}"
                       Margin="0,0,0,-4" />

                <FlexLayout x:Name="HistoryChips"
                            BindableLayout.ItemsSource="{Binding History}"
                            Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="Start"
                            AlignItems="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Style="{DynamicResource AmChip}"
                                    Margin="0,0,8,8"
                                    Padding="14,7"
                                    svc:PressFeedback.IsEnabled="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnHistoryTapped" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding .}" Style="{DynamicResource AmChipText}" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- 常用推荐（占位，后续接榜单/推荐接口） -->
                <Label Text="试试搜索"
                       Style="{DynamicResource AmSectionTitle}"
                       Margin="0,8,0,0" />
                <FlexLayout x:Name="SuggestionChips"
                            Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="Start"
                            AlignItems="Start" />
            </VerticalStackLayout>

            <!-- 搜索中 -->
            <ActivityIndicator IsRunning="{Binding IsSearching}"
                               IsVisible="{Binding IsSearching}"
                               WidthRequest="36"
                               HeightRequest="36"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
        </Grid>
    </Grid>

</ContentPage>
