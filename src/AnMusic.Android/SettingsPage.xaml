<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AnMusic.Android.ViewModels"
             x:Class="AnMusic.Android.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource AmBg}">

    <Grid RowDefinitions="Auto,*">

        <!-- ══ 顶栏 ══ -->
        <Grid Grid.Row="0"
              Style="{DynamicResource AmTopBar}"
              ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0"
                    Text="‹"
                    Style="{DynamicResource AmIconButton}"
                    FontSize="26"
                    Clicked="OnBackClicked" />
            <Label Grid.Column="1"
                   Text="设置"
                   Style="{DynamicResource AmPageTitle}"
                   Margin="4,0,0,0" />
            <Button Grid.Column="2"
                    Text="☰"
                    Style="{DynamicResource AmIconButton}"
                    FontSize="20"
                    Clicked="OnOpenFlyoutClicked" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,4,16,28" Spacing="14">

                <!-- ══════════ 个人资料入口 ══════════ -->
                <Border Style="{DynamicResource AmSectionCard}">
                    <Grid Style="{DynamicResource AmListRow}" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenUserPageTapped" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="👤" Style="{DynamicResource AmListRowIcon}" />
                        <VerticalStackLayout Grid.Column="1" Style="{DynamicResource AmRowStack}">
                            <Label Text="个人资料" Style="{DynamicResource AmTitleText}" FontSize="14" />
                            <Label Text="头像、昵称与听歌统计" Style="{DynamicResource AmCaptionText}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Style="{DynamicResource AmChevron}" />
                    </Grid>
                </Border>

                <!-- ══════════ 外观 ══════════ -->
                <Label Text="外观" Style="{DynamicResource AmSectionTitle}" Margin="4,6,0,0" />

                <Border Style="{DynamicResource AmCard}">
                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Style="{DynamicResource AmRowStack}">
                                <Label Text="主题皮肤" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="{Binding CurrentThemeText}" Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="7 套皮肤 · 6 种强调色"
                                   Style="{DynamicResource AmCaptionText}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- 皮肤选择 -->
                        <FlexLayout x:Name="SkinChips"
                                    BindableLayout.ItemsSource="{Binding Skins}"
                                    Wrap="Wrap"
                                    Direction="Row"
                                    JustifyContent="Start"
                                    AlignItems="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:SkinOption">
                                    <Border Style="{DynamicResource AmChip}"
                                            Margin="0,0,8,8"
                                            Padding="12,6">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnSkinTapped" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="8">
                                            <Border WidthRequest="16"
                                                    HeightRequest="16"
                                                    BackgroundColor="{Binding Background}"
                                                    Stroke="{Binding Accent}"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 8"
                                                    VerticalOptions="Center" />
                                            <Label Text="{Binding DisplayName}"
                                                   Style="{DynamicResource AmChipText}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <BoxView Style="{DynamicResource AmDividerLine}" />

                        <Label Text="强调色" Style="{DynamicResource AmTitleText}" FontSize="14" />
                        <FlexLayout x:Name="AccentChips"
                                    BindableLayout.ItemsSource="{Binding Accents}"
                                    Wrap="Wrap"
                                    Direction="Row"
                                    JustifyContent="Start"
                                    AlignItems="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccentOption">
                                    <Border Style="{DynamicResource AmChip}"
                                            Margin="0,0,8,8"
                                            Padding="10,6">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnAccentTapped" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="7">
                                            <Border WidthRequest="16"
                                                    HeightRequest="16"
                                                    BackgroundColor="{Binding Color}"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 8"
                                                    VerticalOptions="Center" />
                                            <Label Text="{Binding Name}"
                                                   Style="{DynamicResource AmChipText}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ══════════ 播放设置 ══════════ -->
                <Label Text="播放设置" Style="{DynamicResource AmSectionTitle}" Margin="4,6,0,0" />

                <Border Style="{DynamicResource AmCard}">
                    <VerticalStackLayout Spacing="16">

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Style="{DynamicResource AmRowStack}">
                                <Label Text="默认音量" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="{Binding DefaultVolume, StringFormat='{0:P0}'}"
                                       Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Slider Grid.Column="1"
                                    Minimum="0" Maximum="1"
                                    Value="{Binding DefaultVolume}"
                                    Style="{DynamicResource AmProgress}"
                                    WidthRequest="150"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{DynamicResource AmDividerLine}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Style="{DynamicResource AmRowStack}">
                                <Label Text="默认播放模式" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="{Binding PlayModeText}" Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="切换"
                                    Command="{Binding CyclePlayModeCommand}"
                                    Style="{DynamicResource AmCardActionButton}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{DynamicResource AmDividerLine}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Style="{DynamicResource AmRowStack}">
                                <Label Text="封面旋转" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="播放时封面随唱片缓慢转动" Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IsCoverSpinEnabled}"
                                    Style="{DynamicResource AmSwitch}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{DynamicResource AmDividerLine}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Style="{DynamicResource AmRowStack}">
                                <Label Text="在线歌词" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="无本地歌词时自动联网匹配"
                                       Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IsOnlineLyrics}"
                                    Style="{DynamicResource AmSwitch}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{DynamicResource AmDividerLine}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Style="{DynamicResource AmRowStack}">
                                <Label Text="歌词字号" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="{Binding LyricFontSize, StringFormat='{0:F0} px'}"
                                       Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Slider Grid.Column="1"
                                    Minimum="12" Maximum="24"
                                    Value="{Binding LyricFontSize}"
                                    Style="{DynamicResource AmProgress}"
                                    WidthRequest="150"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{DynamicResource AmDividerLine}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Style="{DynamicResource AmRowStack}">
                                <Label Text="歌词配色" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="{Binding LyricColorText}" Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="切换"
                                    Command="{Binding CycleLyricColorCommand}"
                                    Style="{DynamicResource AmCardActionButton}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{DynamicResource AmDividerLine}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Style="{DynamicResource AmRowStack}">
                                <Label Text="音质" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="{Binding AudioQualityText}" Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="选择"
                                    Command="{Binding ComingSoonCommand}"
                                    CommandParameter="音质选择"
                                    Style="{DynamicResource AmCardActionButton}"
                                    VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ══════════ 本地音乐 ══════════ -->
                <Label Text="本地音乐" Style="{DynamicResource AmSectionTitle}" Margin="4,6,0,0" />

                <Border Style="{DynamicResource AmCard}">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Style="{DynamicResource AmRowStack}">
                                <Label Text="扫描目录" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="{Binding MusicDirText}" Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="刷新"
                                    Command="{Binding RefreshMusicDirsCommand}"
                                    Style="{DynamicResource AmCardActionButton}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{DynamicResource AmDividerLine}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding MusicDirectories}"
                                             Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}"
                                           Style="{DynamicResource AmCaptionText}"
                                           LineBreakMode="MiddleTruncation" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ══════════ 音源插件 ══════════ -->
                <Label Text="音源插件" Style="{DynamicResource AmSectionTitle}" Margin="4,6,0,0" />

                <Border Style="{DynamicResource AmCard}" Padding="0,4">
                    <Grid Style="{DynamicResource AmListRow}" ColumnDefinitions="Auto,*,Auto">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenPluginsClicked" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0" Text="🧩" Style="{DynamicResource AmListRowIcon}" />
                        <VerticalStackLayout Grid.Column="1" Style="{DynamicResource AmRowStack}">
                            <Label Text="管理音源插件" Style="{DynamicResource AmTitleText}" FontSize="14" />
                            <Label Text="粘贴 .js 链接安装网易云/QQ/B 站等音源" Style="{DynamicResource AmCaptionText}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Style="{DynamicResource AmChevron}" />
                    </Grid>
                </Border>

                <!-- ══════════ 网络 ══════════ -->
                <Label Text="网络" Style="{DynamicResource AmSectionTitle}" Margin="4,6,0,0" />

                <Border Style="{DynamicResource AmCard}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="代理地址" Style="{DynamicResource AmTitleText}" FontSize="14" />
                            <Label Text="留空则跟随系统。形如 http://127.0.0.1:7890，用于访问在线音源与检查更新。"
                                   Style="{DynamicResource AmCaptionText}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0"
                                   Text="{Binding ProxyUrl}"
                                   Placeholder="http://127.0.0.1:7890"
                                   Keyboard="Url"
                                   Style="{DynamicResource AmEntry}" />
                            <Button Grid.Column="1"
                                    Text="清除"
                                    Command="{Binding ClearProxyCommand}"
                                    Style="{DynamicResource AmCardActionButton}"
                                    VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ══════════ 存储与缓存 ══════════ -->
                <Label Text="存储与缓存" Style="{DynamicResource AmSectionTitle}" Margin="4,6,0,0" />

                <Border Style="{DynamicResource AmCard}">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Style="{DynamicResource AmRowStack}">
                                <Label Text="封面缓存" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="{Binding CoverCacheText}" Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="清理"
                                    Command="{Binding ClearCoverCacheCommand}"
                                    Style="{DynamicResource AmCardActionButton}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{DynamicResource AmDividerLine}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Style="{DynamicResource AmRowStack}">
                                <Label Text="音频缓存" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="{Binding TotalCacheText}" Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="清理"
                                    Command="{Binding ClearAudioCacheCommand}"
                                    Style="{DynamicResource AmCardActionButton}"
                                    VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ══════════ 更多功能 ══════════ -->
                <Label Text="更多功能" Style="{DynamicResource AmSectionTitle}" Margin="4,6,0,0" />

                <Border Style="{DynamicResource AmSectionCard}">
                    <VerticalStackLayout>

                        <Grid Style="{DynamicResource AmListRow}" ColumnDefinitions="Auto,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenEqualizerTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="🎚" Style="{DynamicResource AmListRowIcon}" />
                            <VerticalStackLayout Grid.Column="1" Style="{DynamicResource AmRowStack}">
                                <Label Text="均衡器" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="调节各频段增益与预设音效" Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{DynamicResource AmChevron}" />
                        </Grid>

                        <BoxView Style="{DynamicResource AmDividerLine}" />

                        <Grid Style="{DynamicResource AmListRow}" ColumnDefinitions="Auto,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSleepTimerTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="⏱" Style="{DynamicResource AmListRowIcon}" />
                            <VerticalStackLayout Grid.Column="1" Style="{DynamicResource AmRowStack}">
                                <Label Text="定时关闭" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="{Binding SleepTimerText}" Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{DynamicResource AmChevron}" />
                        </Grid>

                        <BoxView Style="{DynamicResource AmDividerLine}" />

                        <Grid Style="{DynamicResource AmListRow}" ColumnDefinitions="Auto,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenDownloadsTapped" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="⬇" Style="{DynamicResource AmListRowIcon}" />
                            <VerticalStackLayout Grid.Column="1" Style="{DynamicResource AmRowStack}">
                                <Label Text="下载管理" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="查看与管理已缓冲到本机的音频" Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{DynamicResource AmChevron}" />
                        </Grid>

                        <BoxView Style="{DynamicResource AmDividerLine}" />

                        <Grid Style="{DynamicResource AmListRow}" ColumnDefinitions="Auto,*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ComingSoonCommand}" CommandParameter="一起听" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="👥" Style="{DynamicResource AmListRowIcon}" />
                            <VerticalStackLayout Grid.Column="1" Style="{DynamicResource AmRowStack}">
                                <Label Text="一起听" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="与好友同步播放同一首歌" Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Style="{DynamicResource AmChevron}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ══════════ 关于 ══════════ -->
                <Label Text="关于" Style="{DynamicResource AmSectionTitle}" Margin="4,6,0,0" />

                <Border Style="{DynamicResource AmCard}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="版本" Style="{DynamicResource AmTitleText}" FontSize="14" />
                            <Label Grid.Column="1"
                                   Text="{Binding AppVersion}"
                                   Style="{DynamicResource AmCaptionText}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{DynamicResource AmDividerLine}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="构建号" Style="{DynamicResource AmTitleText}" FontSize="14" />
                            <Label Grid.Column="1"
                                   Text="{Binding AppBuild}"
                                   Style="{DynamicResource AmCaptionText}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{DynamicResource AmDividerLine}" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="数据目录" Style="{DynamicResource AmTitleText}" FontSize="14" />
                            <Label Text="{Binding DataRoot}"
                                   Style="{DynamicResource AmCaptionText}"
                                   LineBreakMode="CharacterWrap" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ══════════ 更新与法务 ══════════ -->
                <Border Style="{DynamicResource AmCard}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Style="{DynamicResource AmRowStack}">
                                <Label Text="检查更新" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="{Binding UpdateCheckText}" Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="检查"
                                    Command="{Binding CheckUpdateCommand}"
                                    IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InvertBool}}"
                                    Style="{DynamicResource AmCardActionButton}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{DynamicResource AmDividerLine}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Style="{DynamicResource AmRowStack}">
                                <Label Text="用户协议" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="使用本软件前请阅读" Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="查看"
                                    Command="{Binding ShowAgreementCommand}"
                                    Style="{DynamicResource AmCardActionButton}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{DynamicResource AmDividerLine}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Style="{DynamicResource AmRowStack}">
                                <Label Text="免责声明" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="版权与责任范围说明" Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="查看"
                                    Command="{Binding ShowDisclaimerCommand}"
                                    Style="{DynamicResource AmCardActionButton}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{DynamicResource AmDividerLine}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Style="{DynamicResource AmRowStack}">
                                <Label Text="联系作者" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="835176240@qq.com" Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="复制"
                                    Command="{Binding CopyEmailCommand}"
                                    Style="{DynamicResource AmCardActionButton}"
                                    VerticalOptions="Center" />
                        </Grid>

                        <BoxView Style="{DynamicResource AmDividerLine}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Style="{DynamicResource AmRowStack}">
                                <Label Text="交流 QQ 群" Style="{DynamicResource AmTitleText}" FontSize="14" />
                                <Label Text="348061212" Style="{DynamicResource AmCaptionText}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="复制"
                                    Command="{Binding CopyQQGroupCommand}"
                                    Style="{DynamicResource AmCardActionButton}"
                                    VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="AnMusic · 本地音乐播放器"
                       Style="{DynamicResource AmCaptionText}"
                       HorizontalOptions="Center"
                       Margin="0,10,0,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
