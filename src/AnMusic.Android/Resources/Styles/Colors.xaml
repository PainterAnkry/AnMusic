<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ══════════════════════════════════════════════════════════════
         AnMusic 安卓端颜色令牌 · 默认值（浅色 + 网易红）
         ──────────────────────────────────────────────────────────────
         这里的值是「启动瞬间的兜底」：App 构造时会立刻调用
         ThemeService.Apply(...) 把整套颜色按用户所选皮肤覆写一遍。

         界面必须用 {DynamicResource AmXxx} 引用颜色 —— 用 StaticResource
         会在解析时固化取值，运行时换肤不会生效。
         ══════════════════════════════════════════════════════════════ -->

    <!-- ── 品牌 / 强调（网易云音乐品牌红 #E6212A）── -->
    <Color x:Key="AmPrimary">#E6212A</Color>
    <Color x:Key="AmPrimaryDark">#C81E26</Color>
    <Color x:Key="AmPrimaryHover">#F04A52</Color>
    <Color x:Key="AmPrimarySoft">#FDECEE</Color>
    <Color x:Key="AmAccent">#E6212A</Color>
    <Color x:Key="AmTextOnPrimary">#FFFFFF</Color>

    <!-- ── 背景层级（浅 -> 深）── -->
    <Color x:Key="AmBg">#F6F7F9</Color>
    <Color x:Key="AmSurface">#FFFFFF</Color>
    <Color x:Key="AmSurfaceAlt">#FAFBFC</Color>
    <Color x:Key="AmDivider">#EDEEF1</Color>
    <Color x:Key="AmOverlay">#6B000000</Color>
    <Color x:Key="AmPlayerBg">#FFFFFF</Color>
    <Color x:Key="AmChipBg">#F1F2F5</Color>
    <Color x:Key="AmSkeleton">#ECEDF1</Color>
    <Color x:Key="AmCoverPlaceholder">#E0E1E6</Color>

    <!-- ── 文字层级 ── -->
    <Color x:Key="AmTextPrimary">#1A1A1A</Color>
    <Color x:Key="AmTextSecondary">#5F5F68</Color>
    <Color x:Key="AmTextTertiary">#9A9AA3</Color>

    <!-- ── 功能色 ── -->
    <Color x:Key="AmSuccess">#2FB86B</Color>
    <Color x:Key="AmWarning">#F59E0B</Color>
    <Color x:Key="AmDanger">#E5484D</Color>
    <Color x:Key="AmLike">#E5484D</Color>

</ResourceDictionary>
