<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ══════════════════════════════════════════════════════════════
         AnMusic 安卓端控件样式（网易云音乐风格 · 浅色）
         ══════════════════════════════════════════════════════════════ -->

    <!-- ══ 全局默认 ══ -->

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource AmBg}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource AmTextPrimary}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- ══ 文字层级 ══ -->

    <Style x:Key="AmPageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource AmTextPrimary}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="AmSectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource AmTextPrimary}" />
    </Style>

    <Style x:Key="AmTitleText" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource AmTextPrimary}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="AmSubText" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource AmTextTertiary}" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <Style x:Key="AmBodyText" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource AmTextSecondary}" />
    </Style>

    <Style x:Key="AmCaptionText" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource AmTextTertiary}" />
    </Style>

    <!-- ══ 卡片 ══ -->

    <Style x:Key="AmCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource AmSurface}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- ══ 按钮 ══ -->

    <Style x:Key="AmPrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource AmPrimary}" />
        <Setter Property="TextColor" Value="{StaticResource AmTextOnPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="21" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="0" />
    </Style>

    <Style x:Key="AmGhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource AmChipBg}" />
        <Setter Property="TextColor" Value="{StaticResource AmTextPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="21" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="0" />
    </Style>

    <Style x:Key="AmOutlineButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource AmPrimary}" />
        <Setter Property="BorderColor" Value="{StaticResource AmPrimary}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="0" />
    </Style>

    <Style x:Key="AmIconButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource AmTextPrimary}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="42" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="0" />
    </Style>

    <Style x:Key="AmRowMenuButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource AmTextTertiary}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="WidthRequest" Value="38" />
        <Setter Property="HeightRequest" Value="38" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="0" />
    </Style>

    <Style x:Key="AmSegmentButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource AmTextSecondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="MinimumWidthRequest" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="0" />
    </Style>

    <!-- ══ 输入 ══ -->

    <Style x:Key="AmSearchBar" TargetType="SearchBar">
        <Setter Property="BackgroundColor" Value="{StaticResource AmChipBg}" />
        <Setter Property="TextColor" Value="{StaticResource AmTextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource AmTextTertiary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

    <Style x:Key="AmSearchEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource AmTextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource AmTextTertiary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

    <!-- ══ 分隔线 ══ -->

    <Style x:Key="AmDividerLine" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource AmDivider}" />
    </Style>

    <!-- ══ 进度 / 开关 ══ -->

    <Style x:Key="AmProgress" TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{StaticResource AmPrimary}" />
        <Setter Property="MaximumTrackColor" Value="{StaticResource AmDivider}" />
        <Setter Property="ThumbColor" Value="{StaticResource AmPrimary}" />
    </Style>

    <Style x:Key="AmSwitch" TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource AmPrimary}" />
        <Setter Property="ThumbColor" Value="#FFFFFF" />
    </Style>

    <!-- ══ 封面容器 ══ -->

    <Style x:Key="AmCoverSmall" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource AmCoverPlaceholder}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <Style x:Key="AmCoverMedium" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource AmCoverPlaceholder}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="WidthRequest" Value="56" />
        <Setter Property="HeightRequest" Value="56" />
    </Style>

    <!-- ══ 标签 / 徽标 ══ -->

    <Style x:Key="AmChip" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource AmChipBg}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="12,5" />
    </Style>

    <Style x:Key="AmChipText" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource AmTextSecondary}" />
    </Style>

    <Style x:Key="AmBadge" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource AmPrimarySoft}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 4" />
        <Setter Property="Padding" Value="5,1" />
    </Style>

    <Style x:Key="AmBadgeText" TargetType="Label">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextColor" Value="{StaticResource AmPrimary}" />
    </Style>

    <!-- ══ ActivityIndicator ══ -->

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource AmPrimary}" />
    </Style>

</ResourceDictionary>
