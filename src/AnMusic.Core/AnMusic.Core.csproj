<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 根命名空间保持 AnMusic：内嵌 JS 宿主库的资源逻辑名（AnMusic.Assets.Plugins.*）依赖它 -->
    <RootNamespace>AnMusic</RootNamespace>
    <AssemblyName>AnMusic.Core</AssemblyName>
    <Product>AnMusic</Product>
    <Company>PainterAnkry</Company>
    <Version>3.3.8</Version>
  </PropertyGroup>

  <!-- 插件宿主内置 JS 库（require('crypto-js') 等宿主模块），随 Core 一起发布到各端 -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Plugins\crypto-js.min.js" />
    <EmbeddedResource Include="Assets\Plugins\dayjs.min.js" />
    <EmbeddedResource Include="Assets\Plugins\big-integer.min.js" />
    <EmbeddedResource Include="Assets\Plugins\jsencrypt.min.js" />
    <EmbeddedResource Include="Assets\Plugins\he.min.js" />
  </ItemGroup>

  <!-- AnMusic 维护的内置音源插件（端点失效时随 App 更新修正），由宿主按开关释放到插件目录 -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Plugins\Builtin\*.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.16.1" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

</Project>
